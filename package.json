{
  "name": "ucr-pathways",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-example.mjs all",
    "validate:counselor": "node scripts/validate-counselor-comparison.mjs all && node scripts/validate-counselor-structural-rules.mjs all && node scripts/validate-counselor-final-rules.mjs all",
    "build:counselor": "node scripts/build-counselor-comparison-v2.mjs",
    "build:counselor:v1": "node scripts/build-counselor-comparison.mjs",
    "build:counselor:v2": "node scripts/build-counselor-comparison-v2.mjs",
    "test:counselor-compiler": "npm run test:counselor-compiler:v1 && npm run test:counselor-compiler:v2",
    "test:counselor-compiler:v1": "node scripts/test-counselor-compiler.mjs",
    "test:counselor-compiler:v2": "node scripts/test-counselor-compiler-v2.mjs",
    "validate:registry-interests": "node scripts/validate-registry-interests.mjs",
    "build:counselor-review": "node scripts/build-counselor-review-index.mjs",
    "validate:counselor-review": "node scripts/build-counselor-review-index.mjs --check",
    "test": "node --test scripts/quality.test.mjs"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "playwright": "1.56.0"
  }
}
