{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solmyr1980.github.io/ucr-pathways/data/schema/counselor-final-methodology.schema.json",
  "title": "UCR counselor final methodology audit",
  "description": "Supplemental audit contract for new and re-audited counselor comparison records under the final September 2026 production methodology. It extends, rather than replaces, counselor-comparison.schema.json.",
  "allOf": [
    {
      "$ref": "./counselor-comparison.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "academicRationale": {
          "type": "object",
          "required": [
            "finalMethodologyAudit"
          ],
          "properties": {
            "finalMethodologyAudit": {
              "$ref": "#/$defs/finalMethodologyAudit"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "comparatorRouteSelection": {
      "type": "object",
      "required": [
        "route",
        "selectionRule",
        "basis"
      ],
      "properties": {
        "route": {
          "type": "string",
          "minLength": 1
        },
        "selectionRule": {
          "type": "string",
          "enum": [
            "target-named",
            "broad-academic-identity",
            "least-specialized-general",
            "official-order-tiebreak"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "courseTraceabilityEntry": {
      "type": "object",
      "required": [
        "courseCode",
        "basisLabels",
        "rationale"
      ],
      "properties": {
        "courseCode": {
          "type": "string",
          "minLength": 1
        },
        "basisLabels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "progressionAssessment": {
      "type": "object",
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "alternativeAudit": {
      "type": "object",
      "required": [
        "programmeId",
        "courseTraceability",
        "progressionAssessment"
      ],
      "properties": {
        "programmeId": {
          "type": "string",
          "minLength": 1
        },
        "courseTraceability": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/courseTraceabilityEntry"
          }
        },
        "progressionAssessment": {
          "$ref": "#/$defs/progressionAssessment"
        }
      },
      "additionalProperties": false
    },
    "candidateAssessment": {
      "type": "object",
      "required": [
        "candidateLabel",
        "organisingLogic",
        "assessment"
      ],
      "properties": {
        "candidateLabel": {
          "type": "string",
          "minLength": 1
        },
        "organisingLogic": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "finalMethodologyAudit": {
      "type": "object",
      "required": [
        "coveredByClosestMatchInterestRows",
        "candidateAssessments",
        "alternatives"
      ],
      "properties": {
        "comparatorRouteSelection": {
          "$ref": "#/$defs/comparatorRouteSelection"
        },
        "coveredByClosestMatchInterestRows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 2
          }
        },
        "candidateAssessments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidateAssessment"
          }
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/alternativeAudit"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
