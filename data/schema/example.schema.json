{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solmyr1980.github.io/ucr-pathways/data/schema/example.schema.json",
  "title": "UCR comparison record",
  "description": "Shared comparison contract: exactly one external comparator followed by one to three ordered UCR alternatives. Legacy public role names remain readable during migration; schema 2.0/current production uses ucr-alternative.",
  "type": "object",
  "required": ["schemaVersion", "id", "programmes", "blocks"],
  "properties": {
    "schemaVersion": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "origin": {"type": "string", "enum": ["student", "counselor"]},
    "cohort": {"type": "string"},
    "interests": {"type": "string", "minLength": 1},
    "interestInterpretation": {"type": "string", "minLength": 1},
    "programmeProvider": {
      "type": "object",
      "properties": {
        "counselorProgrammeId": {"type": "string", "pattern": "^cp-[0-9]{6}$"},
        "sourceExcelRow": {"type": ["integer", "string"]},
        "programmeProviderId": {"type": ["string", "integer"]},
        "recognizedProgrammeId": {"type": ["string", "integer"]}
      },
      "additionalProperties": true
    },
    "alternativeSelection": {"$ref": "#/$defs/alternativeSelection"},
    "comparator": {"$ref": "#/$defs/comparatorMetadata"},
    "referenceProgramme": {
      "allOf": [{"$ref": "#/$defs/comparatorMetadata"}],
      "description": "Legacy alias retained during migration. New records should use comparator."
    },
    "links": {
      "type": "object",
      "properties": {
        "ucrCurriculumUrl": {"type": "string", "format": "uri"},
        "studentIntakeUrl": {"type": "string", "format": "uri"},
        "counselorAppUrl": {"type": "string", "format": "uri"},
        "programBuilderUrl": {"type": "string", "format": "uri"},
        "admissionsUrl": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    },
    "display": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "publicTitle": {"type": "string"},
        "interestLabel": {"type": "string"},
        "comparisonNote": {"type": "string"},
        "showComparatorOnLinkedIn": {
          "type": "boolean",
          "description": "When false, the LinkedIn PDF omits the comparator page while retaining all approved UCR alternatives."
        }
      },
      "additionalProperties": true
    },
    "programmes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/programme"},
            {"properties": {"role": {"const": "comparator"}}}
          ]
        }
      ],
      "items": {"$ref": "#/$defs/ucrProgramme"}
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "placement": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["less-disciplinary-depth", "related-fields-not-full-discipline", "missing-specialist-components", "different-curricular-structure", "custom"]
          },
          "params": {"type": "object", "additionalProperties": true},
          "text": {"type": "string", "minLength": 1}
        },
        "required": ["text"],
        "description": "Expand semantic templates upstream. Public renderers consume text; type and params may be retained for provenance.",
        "additionalProperties": true
      }
    }
  },
  "anyOf": [
    {"required": ["comparator"]},
    {"required": ["referenceProgramme"]}
  ],
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "student"}}, "required": ["origin"]},
      "then": {"required": ["interests", "interestInterpretation"]}
    },
    {
      "if": {"properties": {"origin": {"const": "counselor"}}, "required": ["origin"]},
      "then": {
        "required": ["programmeProvider"],
        "properties": {
          "programmeProvider": {
            "anyOf": [
              {"required": ["counselorProgrammeId"]},
              {"required": ["programmeProviderId"]}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "alternativeSelection": {
      "type": "object",
      "properties": {
        "includedCount": {"type": "integer", "minimum": 1, "maximum": 3},
        "stoppingReason": {
          "type": "string",
          "enum": ["maximum-reached", "insufficient-evidence", "not-substantively-distinct", "not-feasible"]
        },
        "assessment": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "comparatorMetadata": {
      "type": "object",
      "required": ["name", "institution", "primarySourceUrl"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "institution": {"type": "string", "minLength": 1},
        "primarySourceUrl": {"type": "string", "format": "uri"},
        "provenance": {"type": "string"},
        "academicYear": {"type": "string"},
        "route": {"type": "string"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/comparatorComponent"}
        }
      },
      "additionalProperties": true
    },
    "comparatorComponent": {
      "type": "object",
      "required": ["id", "name", "credits"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "credits": {"type": ["number", "integer", "string"]},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "programme": {
      "type": "object",
      "required": ["id", "role", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "role": {"type": "string", "enum": ["comparator", "ucr-alternative", "ucr-depth", "ucr-balanced", "ucr-thematic"]},
        "family": {"type": "string", "enum": ["comparator", "ucr"]},
        "alternativeKind": {"type": "string", "enum": ["closest-match", "related-direction", "question-led", "other-defensible"]},
        "label": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "note": {"type": "string"},
        "schedule": {"$ref": "#/$defs/schedule"}
      },
      "additionalProperties": true
    },
    "ucrProgramme": {
      "allOf": [
        {"$ref": "#/$defs/programme"},
        {
          "properties": {
            "role": {"enum": ["ucr-alternative", "ucr-depth", "ucr-balanced", "ucr-thematic"]},
            "schedule": {"$ref": "#/$defs/ucrSchedule"}
          },
          "required": ["schedule"]
        }
      ]
    },
    "course": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "code": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "level": {"type": ["integer", "string"]},
        "credits": {"type": ["number", "integer", "string"]}
      },
      "additionalProperties": true
    },
    "semester": {
      "type": "object",
      "required": ["label", "courses"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "courses": {"type": "array", "items": {"$ref": "#/$defs/course"}}
      },
      "additionalProperties": true
    },
    "ucrSemester": {
      "allOf": [
        {"$ref": "#/$defs/semester"},
        {"properties": {"courses": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/course"}}}}
      ]
    },
    "schedule": {
      "type": "object",
      "required": ["semesters"],
      "properties": {"semesters": {"type": "array", "items": {"$ref": "#/$defs/semester"}}},
      "additionalProperties": true
    },
    "ucrSchedule": {
      "type": "object",
      "required": ["semesters"],
      "properties": {"semesters": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/ucrSemester"}}},
      "additionalProperties": true
    },
    "cell": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "note": {"type": "string"},
            "credits": {"type": ["number", "integer", "string"]},
            "courseCode": {"type": "string", "minLength": 1},
            "componentId": {"type": "string", "minLength": 1},
            "emphasis": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        {"type": "null"}
      ]
    },
    "block": {
      "type": "object",
      "required": ["title", "rows"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cells"],
            "properties": {"cells": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/cell"}}},
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
