{
  "schemaVersion": "2.0",
  "id": "p-003",
  "cohort": "Fall 2026 cohort",
  "interests": "Writing, languages, advertising, and why people buy",
  "display": {
    "publicTitle": "See how this bachelor compares with study options at UCR.",
    "interestLabel": "Starting interests"
  },
  "academicRationale": {
    "alternatives": [
      {
        "programmeId": "ucr-depth",
        "concept": "This programme examines how rhetoric, media, psychology, and consumer research shape communication and purchasing decisions. It combines persuasive and creative communication with social psychology, marketing, behavioural economics, and psycholinguistics."
      },
      {
        "programmeId": "ucr-balanced",
        "concept": "This programme gives greater weight to writing, literature, language, and rhetoric while retaining psychology, marketing, and consumer research. It connects creative expression with the study of persuasion and consumer behaviour."
      },
      {
        "programmeId": "ucr-thematic",
        "concept": "This programme explores how language and media operate within society. It combines rhetoric, writing, literature, film and media studies with psychology, sociology, marketing, and the study of public communication."
      }
    ]
  },
