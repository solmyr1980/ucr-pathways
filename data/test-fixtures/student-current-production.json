  "academicRationale": {
    "alternatives": [
      {
        "programmeId": "ucr-option-1",
        "concept": "This programme combines economics with politics, history, and quantitative and qualitative research to examine economic development and why prosperity differs across countries. It gives particular weight to macroeconomics, public economics, finance, and international governance."
      },
      {
        "programmeId": "ucr-option-2",
        "concept": "This programme approaches prosperity and inequality through political economy, law, and institutions. It combines economics and empirical methods with constitutional and international law, politics, sociology, and history."
      },
      {
        "programmeId": "ucr-option-3",
        "concept": "This programme focuses on how governments, institutions, and social movements shape inequality and social change. It combines economics and policy with law, politics, sociology, history, data, and environmental governance."
      }
    ]
  },
