  "exception": {
    "type": "no-defensible-ucr-match",
    "checkedOn": "2026-11-09",
    "reason": "UCR offers introductory Dutch, psycholinguistics, literary interpretation, rhetoric and creative writing. These courses develop useful language and literary skills. The feasible combinations do not provide sustained study of Dutch-language literature across periods or of the historical development, structure and use of Dutch. Those subjects organise the selected Groningen track and its research training. The separate Frisian direction also requires sustained study of its language, literature and regional culture.",
    "curriculumContext": "Verified 22-component, 180 EC entrant curriculum for the Dutch Language and Culture track.",
    "ucrCourseEvidence": "Screened all active courses, including Dutch, Style & Meaning and Psycholinguistics, and checked the actual contribution of all courses in three feasible trials. The comparison turns on the sustained Dutch literary and linguistic subject matter, even after the planning conflicts were repaired.",
    "candidateAssessment": [
      {
        "concept": "Dutch Language, Literary Interpretation and Rhetoric",
        "generatingRegistryRows": [
          8221,
          8222,
          8224,
          8225,
          8226,
          8233
        ],
        "assessment": "Dutch supplies introductory pronunciation, grammar and cultural comparison. Style & Meaning teaches linguistic and stylistic analysis, while Psycholinguistics directly examines acquisition, bilingualism and comprehension experimentally. Literary analysis, world texts, creative writing and rhetoric offer meaningful disciplinary methods. These methods are not developed through Dutch literary texts across periods, historical Dutch or a sustained analysis of contemporary Dutch usage."
      },
      {
        "concept": "Language, Identity and Multilingual Communities",
        "generatingRegistryRows": [
          8223,
          8227,
          8228,
          8229,
          8232,
          8234
        ],
        "assessment": "Psycholinguistics directly studies bilingualism and acquisition. Stylistics, higher cognition, introductory Dutch and sociology support language and identity inquiry. Native American Histories examines Indigenous storytelling, assimilation and cultural continuity in a distinct setting. Text methods and media contribute complementary tools. The trial does not develop Frisian language preservation, historical linguistics or literary inquiry as a sustained subject."
      },
      {
        "concept": "Literature, Culture and Heritage",
        "generatingRegistryRows": [
          8230,
          8231
        ],
        "assessment": "World myth, literary meaning, life writing, art, film and creative writing supply comparative interpretation across genres and cultural contexts. Introductory Dutch adds basic grammar and everyday cultural practices. The texts and cultural cases do not form a Dutch literary history, and the concept has little sustained linguistics."
      }
    ],
