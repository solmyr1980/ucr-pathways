  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Philosophical foundations",
        "description": "Introduction to philosophy, Enlightenment thought, philosophy in the Netherlands, the human condition, analytic philosophy, history of worldviews, formal logic, and politics and critique",
        "credits": 60
      },
      {
        "title": "Historical and systematic philosophy",
        "description": "History, society and the individual; moral and environmental philosophy; body and power; philosophy of science; ontology and metaphysics; epistemology; language and mind; and philosophy of art, media and technology",
        "credits": 60
      },
      {
        "title": "Advanced study and thesis",
        "description": "Minor or exchange, advanced academic skills options, philosophy in practice, philosophy electives, contemporary thought of technology, and the bachelor thesis",
        "credits": 60
      }
    ]
  },
