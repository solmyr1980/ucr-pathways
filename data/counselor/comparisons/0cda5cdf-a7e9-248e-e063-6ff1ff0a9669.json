  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Public administration foundations",
        "description": "Public administration, sociology, organisation and management, constitutional and administrative law, political science, public policy, economics, welfare and distribution, plus year-long skills",
        "credits": 60
      },
      {
        "title": "Policy, methods and practice",
        "description": "Network governance, qualitative and quantitative methods, policy analysis, public-resource management, research project and a ten-week public-sector internship",
        "credits": 60
      },
      {
        "title": "Specialisation and thesis",
        "description": "Minor or exchange; European and international governance; political philosophy and democracy; people management; policy and society; bachelor thesis",
        "credits": 60
      }
    ]
  },
