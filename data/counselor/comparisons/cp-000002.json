vernance conditions?","evidence":[{"sourceType":"official-source","reference":"https://www.eur.nl/en/bachelor/management-international-social-challenges/why-this-programme"},{"sourceType":"official-source","reference":"https://www.eur.nl/en/essb/media/2026-08-essb-bachelor-eer-26-27"}]},{"label":"How should climate change be governed across public, private and societal actors?","evidence":[{"sourceType":"official-source","reference":"https://www.eur.nl/en/bachelor/management-international-social-challenges/why-this-programme"}]},{"label":"How does technological change affect public organisations?","evidence":[{"sourceType":"official-source","reference":"https://www.eur.nl/en/bachelor/management-international-social-challenges/why-this-programme"}]}],"alternatives":[{"programmeId":"ucr-1","concept":"Closest feasible multidisciplinary approximation of MISOC, combining public administration, politics, international law, sociology, economics, organisation and social-research methods around international social challenges.","basisLabels":["International social and governance challenges","Public administration and public policy","Political science and multi-level governance","International law","Sociology","Economics, welfare and economic stability","Organisation and management","Qualitative and quantitative social research","Research-based advice and professional skills","Global and European governance","Global development","International migration"],"evidence":[{"sourceType":"official-source","reference":"https://www.eur.nl/en/essb/media/2026-08-essb-bachelor-eer-26-27"},{"sourceType":"official-source","reference":"https://www.eur.nl/en/bachelor/management-international-social-challenges/why-this-programme"}]},{"programmeId":"ucr-2","concept":"A transnational governance route centred on global and European institutions, international law, migration, development, economics and technological change in public organisations.","basisLabels":["International social and governa