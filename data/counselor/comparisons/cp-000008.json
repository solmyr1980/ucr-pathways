      {
        "title": "Crime, law and research foundations",
        "description": "Introduction to criminology and law, constitutional and administrative law, methods and techniques, criminal law, sociology and year-long Research Lab",
        "credits": 60
      },
      {
        "title": "Crime, justice and evidence",
        "description": "Explanations of crime, victims, punishment, policing and security, advanced legal and social-science research, and applied research training",
        "credits": 60
      },
      {
        "title": "Specialisation and bachelor research",
        "description": "Advanced criminological themes, elective or minor space and an independent bachelor research project",
        "credits": 60
      }
    ]
  },
