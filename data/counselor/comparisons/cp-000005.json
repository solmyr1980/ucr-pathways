  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Sociological foundations and social questions",
        "description": "Introduction to sociology, key texts, academic skills, organisation and management, inequality, political science, public policy, and population, family and work",
        "credits": 60
      },
      {
        "title": "Methods, research and practice",
        "description": "Culture and identity, qualitative and quantitative methods, city and migration, a ten-week internship, and an independent sociological research project",
        "credits": 60
      },
      {
        "title": "Advanced sociology, specialisation and thesis",
        "description": "Minor or exchange, cohesion and conflict, planetary sociology, theoretical sociology, research in practice, and the bachelor thesis",
        "credits": 60
      }
    ]
  },
