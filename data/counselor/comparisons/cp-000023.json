  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Historical foundations and source skills",
        "description": "Global, early-modern, modern and Dutch history, historiography, historical sources, digital research tools, history and social sciences, and a first-year research paper",
        "credits": 60
      },
      {
        "title": "Focus area and historical methods",
        "description": "A focus in economic history, international relations, social history or cultural history, with major courses, electives and quantitative historical methods",
        "credits": 60
      },
      {
        "title": "Pathway and thesis",
        "description": "A minor and internship, educational minor or international exchange, advanced focus-area study, and an independent bachelor thesis",
        "credits": 60
      }
    ]
  },
