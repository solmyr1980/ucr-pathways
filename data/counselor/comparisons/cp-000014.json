  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Legal foundations and introductory tax law",
        "description": "Legal science, private law, constitutional and administrative law, criminal law, international and EU law, empirical legal studies, introductory tax law, law and economics, and legal-academic skills",
        "credits": 60
      },
      {
        "title": "Tax law and related legal fields",
        "description": "Substantive tax-law study together with administrative, private and company law, fiscal problem solving, and legal writing and advocacy",
        "credits": 60
      },
      {
        "title": "Advanced taxation and completion",
        "description": "Advanced Dutch, international and European tax questions, specialist choices, legal research and the bachelor completion requirements",
        "credits": 60
      }
    ]
  },
