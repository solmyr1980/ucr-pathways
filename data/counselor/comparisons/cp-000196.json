  "exception": {
    "type": "no-defensible-ucr-match",
    "checkedOn": "2026-11-09",
    "reason": "UCR offers mathematics, computation and applied study of energy and environmental systems. It includes some mechanics, thermodynamics, waves and spectroscopy. Even combined in a feasible programme, these courses do not provide sustained study of mechanics, electromagnetism, quantum physics and experimental physics. Those subjects underpin Groningen’s advanced courses and research project.",
    "curriculumContext": "Verified 25-component regular Physics degree for September 2026, 180 EC.",
    "ucrCourseEvidence": "Screened all active course identities and read every selected course in both feasible trials. Sustainability Essentials I and II directly teach selected mechanics, thermodynamics, waves, materials and spectroscopy. Soils & Aquifers uses geophysics. Renewable energy and robotics add physical applications; numerical methods, linear systems and calculus provide tools. Image processing analyses digital signals, while anatomy applies imaging to study structure. These real contributions do not establish the cumulative investigation of physical laws and experimental measurement that defines the target. Course offering conflicts were resolved in the trials and did not determine the disposition.",
    "candidateAssessment": [
      {
        "concept": "Mathematical Modelling, Earth Systems and Energy",
        "generatingRegistryRows": [
          8058,
          8064,
          8068,
          8070
        ],
        "assessment": "The strongest feasible trial contains calculus, numerical methods, signals, programming, mechanics and thermodynamics in sustainability, introductory spectroscopy, geophysical surveying, robotics and energy-system design. These are direct and complementary contributions. They do not form a cumulative inquiry into physical laws through mechanics, electromagnetism, quantum and thermal physics with experimental verification."
      },
      {
        "concept": "Biomedical Systems, Image Analysis and Modelling",
        "generatingRegistryRows": [
          8065,
          8069
        ],
        "assessment": "Anatomy and brain and behaviour introduce imaging in biomedical contexts. Digital image analysis, signals, mathematical modelling and life science form a coherent biomedical methods programme. Acquisition physics, instrumentation and sustained biophysical experiments are absent."
      },
      {
        "concept": "Fundamental and Experimental Physics",
        "generatingRegistryRows": [
          8057,
          8059,
          8060,
          8061,
          8062,
          8063,
          8066,
          8067,
          8071,
          8072
        ],
        "assessment": "Mathematics and computation supply substantive tools. The workbook has introductory physics topics in sustainability and applied work in robotics and geoscience. It does not provide the cumulative fundamental, particle, quantum and experimental studies needed to organise the degree."
      },
      {
        "concept": "Physics Education",
        "generatingRegistryRows": [
          8073
        ],
        "assessment": "Communication and mathematics are transferable. The disciplinary physics and physics-education progression is not supported by the current curriculum."
      }
    ],
