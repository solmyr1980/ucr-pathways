  "exception": {
    "type": "no-defensible-ucr-match",
    "checkedOn": "2026-11-10",
    "reason": "UCR offers child development, language acquisition, research methods and practical school-based work. These contribute to understanding how children learn and develop. The feasible UCR schedules do not develop upbringing, family support, educational design and evaluation into a sustained programme of study. These subjects bring together the psychology, research and practice in the Groningen degree.",
    "curriculumContext": "Verified 180 EC for the Pedagogy and Educational Sciences route.",
    "ucrCourseEvidence": "Screened all active course identities and reviewed each of the selected courses. The current workbook supports developmental, clinical, educational and research contributions including school work. Both trials are feasible; neither develops a cumulative pedagogical programme.",
    "candidateAssessment": [
      {
        "concept": "Child Development, Education and Social Research",
        "generatingRegistryRows": [
          8260,
          8261,
          8262,
          8263,
          8264,
          8265,
          8268,
          8269,
          8270,
          8272
        ],
        "assessment": "Developmental psychology provides attachment, childhood and play, while Psycholinguistics supplies language acquisition, bilingualism and reading. Youth Resilience directly develops school-climate and youth-support work. Rhetoric in Action includes age-appropriate coaching with a primary-school partner. Public economics, education inequality and public-policy methods strengthen the contextual analysis. The trial still lacks a sustained pedagogical inquiry into parenting, family support, educational design and evaluation, and their interaction with child development."
      },
      {
        "concept": "Orthopedagogical Assessment and Child Support",
        "generatingRegistryRows": [
          8266,
          8267,
          8271,
          8273
        ],
        "assessment": "Psychodiagnostics and Psychotherapies supplies interviews, measurement, family therapy and a child/adolescent strand. Psychopathology covers developmental disorders within a broad clinical survey. Youth support, development, experimental methods and health add substance. The resulting trial centres on psychology, without a cumulative sequence in educational and developmental needs assessment, pedagogy and interventions in child and school settings."
      },
      {
        "concept": "Academic Primary-School Teacher Education",
        "generatingRegistryRows": [
          8274
        ],
        "assessment": "The school project, language acquisition, rhetoric and child development contribute genuine teaching and learning content. The combined teacher direction does not support a coherent sequence of subject didactics, curriculum design and supervised classroom practice. This is a substantive difference beyond teaching credentials."
      }
    ],
