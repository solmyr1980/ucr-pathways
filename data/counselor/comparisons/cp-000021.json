  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Mathematics, statistics and economic foundations",
        "description": "Mathematical analysis, probability and statistics, economics, programming, modelling and an introduction to operations research",
        "credits": 60
      },
      {
        "title": "Advanced quantitative methods",
        "description": "Advanced mathematics, statistics, econometrics, operations research and business economics, combining theory with applied modelling",
        "credits": 60
      },
      {
        "title": "Major, seminar and thesis",
        "description": "Minor, exchange or internship followed by a major in logistics analytics, data science for econometrics, econometrics or quantitative finance, with specialist courses, seminar and bachelor thesis",
        "credits": 60
      }
    ]
  },
