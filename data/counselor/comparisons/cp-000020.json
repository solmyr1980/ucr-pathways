  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Communication and media foundations",
        "description": "Communication and media theory, intercultural and organisational communication, media industries and audiences, social-science foundations, digital technologies, research and statistics",
        "credits": 60
      },
      {
        "title": "Methods, focus areas and practice",
        "description": "International communication, quantitative and qualitative methods, digital content, communication management, research workshops, electives, two focus areas and a mandatory internship",
        "credits": 60
      },
      {
        "title": "Advanced study and thesis",
        "description": "Minor or exchange, advanced communication and media seminars, communication ethics, electives, thesis preparation and an empirical bachelor thesis",
        "credits": 60
      }
    ]
  },
