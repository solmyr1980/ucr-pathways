  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Arts and culture foundations",
        "description": "History and sociology of arts and culture, social-science methods, economics, cultural policy, arts and media, cultural management, and academic skills",
        "credits": 60
      },
      {
        "title": "Focus area, methods and internship",
        "description": "Contemporary cultural sociology, heritage, statistics, cultural marketing, electives, and a focus in culture and economics, culture and society, or culture and media, with a mandatory internship",
        "credits": 60
      },
      {
        "title": "Advanced study and bachelor completion",
        "description": "Advanced focus-area courses, electives, minor or exchange opportunities, independent research and the bachelor thesis",
        "credits": 60
      }
    ]
  },
