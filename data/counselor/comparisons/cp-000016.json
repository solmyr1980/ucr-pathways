  "externalCurriculum": {
    "totalCredits": 180,
    "components": [
      {
        "title": "Life-cycle medical curriculum",
        "description": "Patient-oriented, case-based biomedical and clinical learning organised from pregnancy and birth through older age",
        "credits": 120
      },
      {
        "title": "Clinical, scientific and professional strands",
        "description": "Clinical skills, scientific research, identity and professionalism, communication, programme assessment and longitudinal project education",
        "credits": 45
      },
      {
        "title": "Choice project or minor",
        "description": "Chosen project or minor in science, sustainability, technology, health policy or healthcare organisation",
        "credits": 15
      }
    ]
  },
