  "exception": {
    "type": "no-defensible-ucr-match",
    "checkedOn": "2026-11-09",
    "reason": "The closest UCR course cluster offers real study of material culture, ancient societies and heritage. UCR also teaches spatial analysis and field and laboratory methods in Earth science. The available courses do not build those contributions into a sustained archaeology programme that advances from supervised excavation and finds processing to specialist archaeological analysis and research.",
    "curriculumContext": "This 2026–2027 curriculum follows the English-language Archaeology track offered through ACASA, the collaboration between UvA and VU Amsterdam. It includes two field schools, 30 EC of elective study and a 12 EC thesis. The universities announced a jointly awarded degree beginning in 2027–2028.",
    "ucrCourseEvidence": "The current workbook supports substantive archaeological interpretation, object description and technical drawing, heritage analysis, and transferable GIS, geological stratigraphy, spatial data and environmental sampling. General museum, arts, history and communication courses broaden cultural context. The course set does not support cumulative archaeological excavation, recording of archaeological contexts, specialist finds and materials analysis, or research following excavated evidence through to publication. The strongest integrated candidate cannot sustain the defining archaeological progression as a full UCR curriculum, regardless of term coverage.",
    "candidateAssessment": [
      {
        "concept": "Material culture, past societies and excavation",
        "generatingRegistryRows": [
          16726,
          16727,
          16728,
          16730,
          16731,
