  "exception": {
    "type": "no-defensible-ucr-match",
    "checkedOn": "2026-11-07",
    "reason": "The strongest feasible UCR plans support comparative biology, epidemiology, ecology and biomedical research. They do not provide the linked animal organ-system, pathology and veterinary clinical reasoning sequence that defines Utrecht’s bachelor.",
    "curriculumContext": "Utrecht combines veterinary organ-system blocks with longitudinal clinical and professional training, 22.5 EC of profiling courses and a 7.5 EC thesis within the professional sequence.",
    "ucrCourseEvidence": "Comparative neurobiology includes animal behaviour, welfare and research ethics. Sustainable Farming & Innovation includes animal husbandry and aquaculture. Epidemiology, infection, immunology, pathology and anatomy give useful biological and methodological foundations. UCR does not sustain animal-specific diagnosis, veterinary treatment or the integration of clinical cases with organ-system study.",
    "candidateAssessment": [
      {
        "concept": "Comparative biology, animal health and disease science",
        "generatingSourceInterestExcelRows": [
          14702,
          14704,
          14708,
          14709
        ],
        "generatingRegistryRows": [
          14734,
          14736,
          14740,
          14741
        ],
        "assessment": "Comparative neurobiology and biodiversity, anatomy, human physiology, disease mechanisms, infection and pharmacology provide meaningful foundations. The courses lack a comparative sequence in the organ systems, reproduction, feeding and diseases of relevant animal species."
      },
      {
        "concept": "One Health, disease ecology and welfare",
        "generatingSourceInterestExcelRows": [
          14706,
          14707
        ],
        "generatingRegistryRows": [
          14738,
          14739
        ],
        "assessment": "Epidemiology and infection, comparative neurobiology, husbandry and aquaculture, ecology and environmental governance provide genuine overlap. The plan lacks sustained zoonosis control, veterinary public health, and practical animal welfare assessment within a study of animal disease."
      },
      {
        "concept": "Veterinary diagnosis and clinical animal care",
        "generatingSourceInterestExcelRows": [
          14703,
          14705
        ],
        "generatingRegistryRows": [
          14735,
          14737
        ],
        "assessment": "Anatomical observation, microbial laboratory work, human disease mechanisms and research-based health psychology provide transferable skills. Clinical animal examination, diagnostic reasoning across species, anaesthesia and surgical skills have no connected taught sequence."
      }
    ],
