        ],
        "outcome": "not-defensible",
        "assessment": "Literary interpretation, stylistics, documentary and comparative art can support regional study. The available titles and content do not provide sustained Russian literary, language or cultural study, even when related coursework is combined."
      },
      {
        "concept": "Russian history, politics, economy and international relations",
        "generatingRegistryRows": [
