  "exception": {
    "type": "no-defensible-ucr-match",
    "checkedOn": "2026-11-10",
    "reason": "UCR offers European history, literary and film analysis, and general linguistics. Courses include material on European New Waves, French thinkers and the French Declaration of Rights. The feasible combinations do not sustain study of French and Francophone literature, society and language as a connected field. Those subjects underpin the University of Amsterdam’s advanced coursework and research project.",
    "curriculumContext": "Verified full-time 180 EC entrant curriculum, including the 30 EC abroad component and 12 EC research project.",
    "ucrCourseEvidence": "Screened all active course identities, including description-only courses, and checked each selected course in two feasible trials. Related literary, film, linguistic and historical methods have substantive value. French examples do not establish a sustained study of France, the Francophone world and the French language.",
    "candidateAssessment": [
      {
        "concept": "Modern Europe, Politics and Social Change",
        "generatingRegistryRows": [
          17962,
          17963,
          17964,
          17966,
          17967,
          17968
        ],
        "assessment": "Modern history, European institutions and comparative politics provide substantial historical and institutional context. Human Rights examines the French Declaration in a wider tradition. Literary and film courses address cultural representation and European New Waves. The degree’s France and Francophone centre, with sustained use of French-language materials across disciplines, remains absent."
      },
      {
        "concept": "Literature, Media and Cultural Identity",
        "generatingRegistryRows": [
          17961,
          17965,
          17969,
          17970
        ],
        "assessment": "Close reading, literary theory, art historiography and cinema provide genuine methodological depth. Film includes European New Waves and documentary includes cinéma vérité. Art historiography reads Foucault and Derrida. Stylistics and psycholinguistics add linguistics. The French-specific material is bounded within wider courses and does not sustain French-language literary history, French linguistics and cultural inquiry across the schedule."
      },
      {
        "concept": "French Proficiency, Linguistics and Writing",
        "generatingRegistryRows": [
          17959,
          17960
        ],
        "assessment": "Style & Meaning and Psycholinguistics directly teach linguistic analysis and language acquisition, but do not establish sustained study of French grammar, sound, written discourse and language policy. Creative and rhetorical practice is transferable. The limitation is academic across language, literature and culture, rather than absence of a course label or study abroad."
      }
    ],
