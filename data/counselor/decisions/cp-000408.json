  "exception": {
    "type": "no-defensible-ucr-match",
    "checkedOn": "2026-11-10",
    "reason": "UCR offers Renaissance Italian art, European politics, comparative literature and film. These courses do not form a sustained study of modern Italian society, history and culture. The UvA degree connects those subjects through Italian-language source work, translation and research.",
    "curriculumContext": "Verified full-time 180 EC curriculum for Italian Studies at UvA, including compulsory study in Italy and a separate free elective space.",
    "ucrCourseEvidence": "Screened the current enriched reference and checked complete feasible schedules in regional history and politics, and in literary, media and linguistic study. A direct Renaissance Italian art course and relevant methods do not establish sustained coverage of modern Italy or Italian cultural and linguistic work.",
    "candidateAssessment": [
      {
        "concept": "Modern Italy in European and Mediterranean context",
        "generatingRegistryRows": [
          18682,
          18685,
          18686,
          18687,
          18688,
          18689,
          18691,
          18693
        ],
        "assessment": "Renaissance Italy & Global Mediterranean studies Italian visual culture and cross-cultural exchange directly. European politics, modern history, social theory and research methods add relevant context, but do not sustain a sequence in modern Italian history, society, politics or national identity. Ancient Rome and Renaissance art do not supply modern Italian study."
      },
      {
        "concept": "Italian literature, film and cultural interpretation",
        "generatingRegistryRows": [
          18690,
          18692
        ],
        "assessment": "Comparative literary and film courses support close reading, genre, adaptation and visual analysis, and the Renaissance course gives real Italian cultural content. None of the selected evidence establishes an Italian literary corpus, a progression in Italian cinema or source work connecting these forms to modern Italy. The programme as a whole would study comparative culture more broadly."
      },
      {
        "concept": "Italian language, linguistics and translation",
        "generatingRegistryRows": [
          18683,
          18684
        ],
        "assessment": "Psycholinguistics examines comprehension, production, bilingualism and acquisition. Stylistics examines how grammatical choices shape meaning. Neither studies Italian grammar, language history or translation, and the current course reference supplies no Italian proficiency sequence or Italian-language research progression."
      }
    ],
