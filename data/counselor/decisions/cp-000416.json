  "exception": {
    "type": "no-defensible-ucr-match",
    "checkedOn": "2026-11-10",
    "reason": "UCR offers related study in media, culture, cognition and computing, including some coursework that examines music and sound. These courses do not provide a sustained sequence in music theory, aural skills, score analysis and music history, or dedicated research in music cognition and musical cultures.",
    "curriculumContext": "Verified 180 EC full-time degree under adopted Part B Article B4.1 and Appendices 1–2. The degree includes three variants; this example uses the Cognitive and Computational Musicology route.",
    "ucrCourseEvidence": "Two complete, workbook-feasible trial curricula tested cultural and historical interpretation and cognitive and computational inquiry. Both include genuine music-adjacent or sound-related evidence. Neither sustains Musicology’s disciplinary core or an adequately weighted music-specific direction.",
    "candidateAssessment": [
      {
        "concept": "Music theory, history and repertoire",
        "generatingRegistryRows": [
          19194,
          19195,
          19200,
          19202,
          19204,
          19208,
          19209,
          19211
        ],
        "assessment": "Film and literature courses support interpretation, while history and art courses supply context. The evidence does not establish a cumulative sequence in music theory, aural skills, score analysis, musical performance analysis, or historical repertoire."
      },
      {
        "concept": "Music in culture and society",
        "generatingRegistryRows": [
          19196,
          19197,
          19199,
          19201,
          19203,
          19207,
          19210,
          19212
        ],
        "assessment": "Media & Race and Native American Histories use music within specific cultural and historical inquiries. Media Archaeology, documentary and qualitative methods extend interpretation of sound and culture. These contributions are bounded and cannot sustain a programme in musical traditions, ethnomusicology or popular music."
      },
      {
        "concept": "Music cognition and empirical research",
        "generatingRegistryRows": [
          19198,
          19205,
          19206
        ],
        "assessment": "Perception, higher cognitive functions, statistics, signal analysis and programming provide transferable methods. They do not supply a progression in music cognition, rhythm, musical listening experiments or computational music research."
      }
    ],
