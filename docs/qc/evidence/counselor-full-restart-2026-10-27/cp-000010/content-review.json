  "notes": [
    {
      "type": "missing-specialist-components",
      "placement": "comparison",
      "text": "Erasmus Economics and Business Economics provides a fixed two-year specialist sequence with dedicated History of Economic Thought, intermediate accounting and deeper programme-specific economics, statistics and research, followed by an approved third-year major, seminar and major-linked thesis. UCR can build coherent economics/business, behavioural-consumer and finance/quantitative programmes, but none reproduces that complete specialist sequence or the selected EUR major. In particular, no unrelated history course, invented major elective or generic UCR project is presented as the comparator's missing component."
    }
  ],
  "labelsAndConcepts": [
