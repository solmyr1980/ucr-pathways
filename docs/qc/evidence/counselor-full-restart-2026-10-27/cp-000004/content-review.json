    "componentNotes": {
      "psy-elective": "10 EC of psychology profiling: two programme-offered 5-EC electives, one five-week and one nine-week course; places may be limited.",
      "psy-minor": "15 EC of approved minor or exchange space.",
      "psy-thesis": "Required 14-EC thesis. Optional UCR independent research is additional and unscheduled."
    }
  },
  "labelsAndConcepts": [
    {
      "label": "Psychology, behaviour & social contexts",
      "concept": "Social, developmental, clinical and cognitive psychology are studied through empirical research and evidence synthesis. Organisational psychology, biological foundations, behavioural economics and social theory add distinct perspectives on people, mental processes and social settings."
    },
    {
      "label": "Brain, cognition & mind",
      "concept": "Brain and behaviour, perception, memory and language form the centre of this programme. Neuroscience and psychology connect with data analysis and computational models of vision, while philosophy examines consciousness, emotion and the self."
    },
    {
      "label": "Psychology, leadership & organisations",
      "concept": "Psychology of work and organisations connects with leadership, diversity, negotiation, behavioural decision-making and empirical research. Sociology and business courses examine the institutional settings in which people work."
    }
  ],
  "notes": [
    {
      "type": "missing-specialist-components",
      "placement": "comparison",
      "text": "The Erasmus curriculum includes specialist psychological assessment, psychometrics, professional skills and a required 14-EC thesis. These UCR programmes offer related academic study and do not establish the same specialist preparation or automatic access to a particular master’s programme."
    }
  ],
