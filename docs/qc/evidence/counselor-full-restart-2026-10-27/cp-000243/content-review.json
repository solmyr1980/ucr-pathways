      ],
      "yearLabel": "2026–2027",
      "routeLabel": "Interdisciplinary Social Sciences; Transformations to Sustainability",
      "limitation": "The 180-EC pathway includes Statistics 2 and Sociological Themes as its two major electives, two named required sustainability courses, a further approved 6-EC theme elective, 30 EC of approved mobility/minor choice, and a 12-EC major thesis. GROW activities carry no credits."
    },
    "conceptProgrammeIds": [
