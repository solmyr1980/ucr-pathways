    "componentNotes": {
      "y2-theme-elective": "One approved 6-EC elective within Transformations to Sustainability; the published overview leaves the specific selection open.",
      "y3-mobility": "Choose one approved 30-EC option: exchange, Humanities and Digital Sciences electives, a Tilburg minor, another Dutch university minor, or a free minor.",
      "y3-capstone": "Required 12-EC Sustainability Think Tank and Governance capstone linked to the selected theme; often with an external partner.",
      "y3-thesis": "Required 12-EC independent thesis within Interdisciplinary Social Sciences. UCR optional independent research is additional and unscheduled."
    }
  },
  "notes": [
    {
      "type": "structured-choice-and-specialist-depth",
      "placement": "comparison",
      "text": "The Tilburg comparison follows Interdisciplinary Social Sciences with Transformations to Sustainability. Its named major requirements, required theme courses and theme-specific capstone differ from UCR’s three interdisciplinary approaches. The remaining approved theme elective and mobility window retain genuine choice. Shared rows indicate partial subject relationships; the required major thesis remains distinct from optional UCR research."
    }
  ],
  "labelsAndConcepts": [
    {
      "label": "Society, organisations & sustainable public challenges",
      "concept": "Sociology, organisational behaviour and economics connect with comparative politics, law, ethics and social psychology to examine inequality, communities and public choices. Qualitative and quantitative research, environmental justice, sustainability governance, climate science and digital inquiry support analysis of societal transformation."
    },
    {
      "label": "Cognitive neuroscience, behaviour & society",
      "concept": "Brain and behaviour, neurobiology, higher cognitive functions, perception, language and psychological development form a sustained neuroscience and psychology inquiry. Experimental statistics, evidence synthesis and data work connect this inquiry to clinical, social and philosophical questions."
    },
    {
      "label": "Law, politics & contested culture",
      "concept": "Public, constitutional, international, private and European law connect with democracy, international relations and peace/conflict. Historical inquiry, philosophy, rhetoric, literature and media examine how rights, power and cultural meanings are constructed and contested."
    }
  ],
