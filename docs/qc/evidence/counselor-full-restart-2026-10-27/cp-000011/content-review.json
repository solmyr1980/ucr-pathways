  "notes": [
    {
      "type": "related-fields-not-full-discipline",
      "placement": "comparison",
      "text": "The Rotterdam programme is a full philosophy curriculum: a systematic sequence in the history of philosophy, epistemology, metaphysics, logic, philosophy of science, philosophy of language and mind, moral and political philosophy, closing with a 15-EC philosophical thesis. UCR teaches five philosophy courses — Introduction to Western Philosophy, Ethics, Philosophy of Mind, Philosophy of Emotion, and Free Will, Time & the Self — together with Introduction to Political Philosophy, Human Rights: Law & Philosophy and AI Ethics. At UCR the remaining philosophical ground is approached through neighbouring fields: the history of ideas through history, social critique through sociology, interpretation through literary study and rhetoric, and mind and language through cognitive science. These programmes therefore offer related perspectives on philosophical questions rather than reproducing a full philosophy curriculum, and UCR has no dedicated epistemology, philosophy of science or single-philosopher course."
    }
  ],
  "labelsAndConcepts": [
    {
      "label": "Philosophy, ethics & the human sciences",
      "concept": "The closest feasible UCR response to a full philosophy bachelor: the philosophical core of ethics, mind, metaphysics, political philosophy and logic, extended through the fields in which UCR teaches the history of ideas, social theory, textual interpretation and the empirical study of mind and language."
    },
    {
      "label": "Philosophy, technology, media & artificial intelligence",
      "concept": "A programme organised around the philosophical and ethical evaluation of technology, information and artificial intelligence: the philosophical core is retained, and the elective space goes to media theory and to the technical study of the systems whose claims and effects are being assessed."
    },
    {
      "label": "Ethics, sustainability & environmental practice",
      "concept": "A programme organised around what we owe to nature, to future generations and to each other: moral and political philosophy applied to environmental practice, with the sustainability science, governance and technology that the normative questions are about."
    }
  ],
