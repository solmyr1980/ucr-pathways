  "labelsAndConcepts": [
    {
      "label": "Business, management & entrepreneurship",
      "concept": "Business foundations, strategy and marketing connect with leadership, organisational psychology and international business. Accounting, financial markets and bank decisions, economics, empirical research and data analysis support the study of firms and management."
    },
    {
      "label": "Business, sustainability & responsible management",
      "concept": "Business strategy, marketing, organisational behaviour and ethical leadership connect with climate, life-cycle assessment and circular resource use. Technical study of materials, farming and renewable energy supplies specific applications for evaluating sustainable business decisions."
    },
    {
      "label": "Finance, economics & business analytics",
      "concept": "Financial statements, investment appraisal, securities and banking connect with economics, econometrics, probability and data methods. Programming and intelligent-agent decision theory provide complementary analytical tools; strategy, negotiation and international business connect the analysis to management."
    }
  ],
