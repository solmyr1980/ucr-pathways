  "notes": [
    {
      "type": "missing-specialist-components",
      "placement": "comparison",
      "text": "Tilburg's IBA provides a dense compulsory sequence across international business functions, including supply chains, human-resource management, management accounting, cross-cultural management, corporate governance and a required business thesis. UCR can build coherent international-business, technology and finance programmes, but it does not reproduce the same complete functional sequence or required thesis."
    }
  ],
  "labelsAndConcepts": [
    {
      "label": "International business, management & entrepreneurship",
      "concept": "An international-business programme combining global strategy, entrepreneurship, marketing, leadership, organisational behaviour and governance with accounting, finance, economics, research, data, technology and business law."
    },
    {
      "label": "Business, AI & digital transformation",
      "concept": "An international-business direction organised around analytics, artificial intelligence and digital transformation, combining programming, machine learning and deep learning with strategy, organisations, marketing, finance and responsible technology."
    },
    {
      "label": "Finance, economics & international business",
      "concept": "Financial statements, investment appraisal, securities, banking and monetary risk connect with microeconomics, international macroeconomics, public economics and behavioural decision-making. Econometrics, probability, data methods and cross-border business law support evidence-based financial and international-business analysis."
    }
  ],
