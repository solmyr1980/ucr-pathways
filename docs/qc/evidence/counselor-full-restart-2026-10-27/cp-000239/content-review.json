  "labelsAndConcepts": [
    {
      "label": "Philosophy, society & interpretation",
      "concept": "Philosophical inquiry into knowledge, ethics, mind, agency and political authority is supported by logic, critical social theory and interpretation of historical and literary texts. Social psychology provides a specific empirical perspective on persons and moral judgment. The programme combines philosophical reading and argument with interdisciplinary cases while retaining important specialist gaps."
    },
    {
      "label": "Ethics, politics, justice and institutions",
      "concept": "Ethics, political philosophy, logic and human-rights reasoning examine responsibility, justice, freedom and authority. Law, social theory, gender history and literary interpretation provide specific institutions, social experiences and arguments through which those normative questions can be assessed."
    },
    {
      "label": "Mind, language, cognition and artificial intelligence",
      "concept": "Philosophy of mind, emotion, agency and ethical responsibility is examined alongside empirical cognition, language and neuroscience. Logic, programming and statistical methods provide complementary ways to assess representation, artificial inference and competing evidence about mental life. Empirical training does not replace philosophical argument."
    }
  ],
  "notes": [
    {
      "type": "less-disciplinary-depth",
      "placement": "comparison",
      "text": "Tilburg provides a sustained philosophy curriculum with dedicated history of philosophy, epistemology, metaphysics, philosophical methods and language study, followed by the general Philosophy track and a required 10-EC thesis. The UCR options combine substantive philosophy with other fields and retain important specialist gaps. Optional independent research is additional to the displayed 180 EC and is not a required philosophy thesis."
    }
  ],
