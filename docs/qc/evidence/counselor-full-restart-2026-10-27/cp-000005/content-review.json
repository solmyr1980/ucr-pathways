    ],
    "noteTypes": [
      "missing-specialist-components"
    ],
    "componentNotes": {
      "soc-culture": "The UCR counterpart studies gender and identity through a particular historical context; it is narrower than the general sociological component.",
      "soc-policy": "The UCR counterpart studies policy-making processes through a specific policy case and policy memos; its scope is narrower than the general component.",
      "soc-planet": "The UCR counterpart combines climate-related social questions with substantial natural science."
    }
  },
  "notes": [
    {
      "type": "missing-specialist-components",
      "placement": "comparison",
      "text": "The Erasmus bachelor includes a structured sociological sequence, a required 15-EC internship and a required 15-EC bachelor project. The UCR programmes retain related academic inquiry but do not reproduce those requirements or the same specialist preparation."
    }
  ],
  "labelsAndConcepts": [
    {
      "label": "Sociology & social research",
      "concept": "Sociological theory and qualitative and quantitative research anchor a programme in social change. Politics, economics, history and social psychology provide complementary ways to study institutions, inequality and collective life."
    },
    {
      "label": "Politics, inequality & social change",
      "concept": "Sociology, law, politics and history examine how institutions shape rights, inequality and social change. Empirical methods and public economics support policy analysis, while gender and Indigenous histories examine specific experiences of exclusion."
    },
    {
      "label": "Society, sustainability & technology",
      "concept": "Social theory and empirical methods examine how technology and environmental change affect work, institutions and public decisions. Climate and life-cycle analysis supply environmental evidence, while organisational psychology and AI-related study address changes in work and organisations."
    }
  ],
