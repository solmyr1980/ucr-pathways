      ],
      "yearLabel": "2026–2027",
      "routeLabel": "Sociology; Dutch-language, full-time",
      "limitation": "The 180-EC programme includes a 15-EC internship, a 15-EC research project, a 15-EC bachelor project and an open 15-EC minor. No minor subject is assumed."
    },
    "conceptProgrammeIds": [
      "ucr-1",
