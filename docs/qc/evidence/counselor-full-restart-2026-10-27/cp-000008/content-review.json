  "notes": [
    {
      "type": "missing-specialist-components",
      "placement": "comparison",
      "text": "Erasmus Criminology has a dedicated sequence in criminological theory, crime measurement and harm, criminal careers, Dutch criminal procedure/substantive law, law enforcement and mixed-methods research. UCR offers related socio-legal, psychological and empirical study, including actual criminal-law and organised-crime content, but does not reproduce that complete disciplinary sequence, specialised victimology/support training or the 21-EC final research strand. General EU law, psychology and evidence synthesis remain complementary perspectives."
    }
  ],
  "labelsAndConcepts": [
    {
      "label": "Crime, society & justice",
      "concept": "Criminal responsibility and justice connect with sociology, social psychology and empirical research. Legal study, rights and social theory provide perspectives on crime and social responses, while developmental psychology and youth resilience offer specific behavioural and prevention-related contributions. Public policy processes and policy-memo writing add a further perspective on institutional responses."
    },
    {
      "label": "Law, public authority & criminal justice",
      "concept": "Criminal law, rights and constitutional study connect with political authority, ethics and European institutions. Sociology and empirical methods support the study of law and society, while public economics adds a general framework for assessing public intervention. Public policy processes and policy-memo writing add a further perspective on institutional responses."
    }
  ],
