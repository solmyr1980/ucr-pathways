  "labelsAndConcepts": [
    {
      "label": "Quantitative economics, econometrics & optimisation",
      "concept": "A quantitative response to Econometrics and Operations Research built around mathematics, statistics, econometrics, economics, programming, algorithms and optimisation.",
      "rationale": "The completed curriculum is organised around economics, econometrics and optimisation, supported by mathematics, statistics, programming, algorithms and data analysis; the label avoids presenting UCR as offering the comparator's full specialist econometrics sequence."
    },
    {
      "label": "Econometrics, data science & predictive modelling",
      "concept": "A computational economic-data direction combining econometrics with programming, software development, machine learning, neural networks, algorithms and quantitative economic applications.",
      "rationale": "The completed curriculum retains the econometric and economic core but adds software development, neural networks, AI ethics and AI/business applications, making data science and predictive modelling a visible organising strand rather than calling the whole programme simply Econometrics."
    },
    {
      "label": "Quantitative economics & finance",
      "concept": "A quantitative economics and finance direction combining mathematics, statistics, econometrics and programming with corporate finance, banking, macroeconomics, microeconomics and financial decision-making.",
      "rationale": "The completed curriculum combines mathematical, statistical and econometric training with accounting, business foundations, banking and finance, macroeconomics and behavioural economics; this supports a finance direction without overstating UCR as offering a full specialist quantitative-finance major."
    }
  ],
