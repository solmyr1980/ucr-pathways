        "y3-thesis"
      ],
      "yearLabel": "2026–2027",
      "routeLabel": "English-language bachelor; standard core with Commercial Law",
      "limitation": "The 180 EC include 30 EC of approved mobility/minor choice and a required 12-EC thesis. Communication skills and GROW include zero-credit activities. Choosing the Dutch Law minor changes the final-year core and is a separate pathway from the one shown."
    },
    "conceptProgrammeIds": [
      "ucr-1",
      "ucr-2",
      "ucr-3"
    ],
    "noteTypes": [
      "related-fields-not-full-discipline"
    ],
    "componentNotes": {
      "y3-mobility": "30 EC of approved choice compatible with the displayed standard core. The Dutch Law minor instead replaces Commercial Law with Dutch civil procedure; it is not combined with this pathway. Some minor options include Dutch-taught courses.",
      "y3-thesis": "Required 12-EC legal thesis. Optional UCR independent research is additional and unscheduled."
    }
  },
  "labelsAndConcepts": [
    {
      "label": "Global and comparative law, institutions & justice",
      "concept": "Comparative, international, EU, constitutional, criminal and private law are studied through legal interpretation, case analysis and argument. Political philosophy, institutions, social history and theory, ethics and cross-border commerce place legal problems in specific global contexts. Specialist legal depth and the required LLB thesis remain important differences."
    },
    {
      "label": "Commercial law, business & global regulation",
      "concept": "A commercial-law direction connecting private, international, constitutional and EU law with transnational business law, accounting, finance, economics, strategy, corporate governance, negotiation and applied business research."
    },
    {
      "label": "Law, sustainability & environmental governance",
      "concept": "Comparative, international, EU, criminal, private and human-rights law connect with climate change, life-cycle assessment, water governance, public policy, economics and ethical reasoning. Legal methods and environmental evidence approach sustainability problems from different disciplines; the programme does not reproduce a specialist environmental-law or litigation sequence."
    }
  ],
  "notes": [
    {
      "type": "related-fields-not-full-discipline",
      "placement": "comparison",
      "text": "UCR offers a substantial interdisciplinary law curriculum but not Tilburg's 180-ECTS LLB, specialist legal-skills sequence, required legal thesis or Dutch qualifying-law route. These pathways should not be read as qualifying law degrees."
    }
  ],
