  "courseFacts": {
    "ACCPPDE101": {
      "name": "Personal & Professional Development",
      "prerequisite": "NONE",
      "contribution": "Mandatory Year1 PPD supports academic writing,reflection andcommunity engagement. No disciplinary communication orbiology-ethics equivalence."
    },
    "BENECON311": {
      "name": "Public Economics",
      "prerequisite": "BENGATE102",
      "contribution": "Public goods,externalities,equity,health/social expenditure andeconomicpolicyanalysis directly support health/environmental intervention andcollective-choice questions; notcommunicationcampaign training."
    },
    "BENENTR211": {
      "name": "Marketing & Consumer Engagement",
      "prerequisite": "BENGATE102",
      "contribution": "Consumerpsychology,behaviouralframing,advertising/brandanalysis,primary/secondaryconsumerresearch andjourneymapping directlysupportpersuasiveconsumercommunication andresponsiblemessageplanning; no promisedfoodtastingstudy."
    },
    "BENGATE102": {
      "name": "Research Methods & Statistics",
      "prerequisite": "NONE",
      "contribution": "Empiricaldesign,measurement,sampling,surveys/experiments,Ranalysis andactualteamdatacollection supportcommunication/health/environmentalresearch; not a wholethesispreparationguarantee."
    },
    "BENLEAD311": {
      "name": "Psychology of Organizations & Leadership",
      "prerequisite": "BENGATE102",
      "contribution": "Organisationalbehaviour,motivation,teams,power,culture/change andsystematicliteraturereview supply concrete internal-communication/change evidence,not genericcareerreadiness."
    },
    "DISDATA111": {
      "name": "Introduction to Data Science",
      "prerequisite": "NONE",
      "contribution": "Rcleaning/joining/visualisation oftabular,textual/spatialdata andastudentresearchproject supportcommunication/publicevidence inquiry. No fixedlife-sciencedataset promised."
    },
    "ENSDELT312": {
      "name": "Governance of Sustainability",
      "prerequisite": "NONE",
      "contribution": "Power,participation,justice,stakeholder/policy-option matrices,expertinterviews andpolicyadvice onfood/water/energy/climate directly implement environmentalgovernance andpublicengagement."
    },
    "ENSENVI211": {
      "name": "Earth Observation",
      "prerequisite": "ENSGATE101",
      "contribution": "ArcGIS/spatialvisualisation,remotesensing andcollaborativeenvironmentalcaseanalysis support geographically grounded publicenvironmentalevidence; notmediaeffects orcampaign-design equivalence."
    },
    "ENSENVI311": {
      "name": "Environmental Biogeochemistry",
      "prerequisite": "ENSGATE101",
      "contribution": "Aqueous/speciation/redox/adsorption/weathering chemistry,laboratoryinvestigation andgeochemicalmodelling provide substantivewater/contaminant/remediation evidence fortheclosest environmental-science application. Not genericcontext or communicationmethodcourse."
    },
    "ENSGATE101": {
      "name": "Sustainability Essentials I",
      "prerequisite": "NONE",
      "contribution": "Planetaryboundaries,nutrientcycles,acidification,energy/materialscience,dynamicmodels anditerativebiopolymermeasurement give actualscientificfoundations forenvironmentalcommunication; notmerebreadth."
    },
    "ENSGATE201": {
      "name": "Sustainability Essentials II",
      "prerequisite": "ENSGATE101",
      "contribution": "Wave/chemistry/materialsanalysis andlaboratorywork deepen scientific understanding; actualgreenwashingcaseanalysis andpublicsustainabilityproject directlyconnect evidence tocommunication. EarlierENSGATE101 ismandatory."
    },
    "ENSSUST111": {
      "name": "Climate Change",
      "prerequisite": "NONE",
      "contribution": "Climatefeedbacks,tippingpoints,acidification,ecosystem/healthimpacts,misinformation andstakeholderinterview/short-filmproduction connect domainknowledge withpublicclimatecommunication."
    },
    "GOSGATE102": {
      "name": "Law, Society & Justice",
      "prerequisite": "NONE",
      "contribution": "Legal/social/normativeframeworks,justice,caseinterpretation andsociolegalresearchproposal support environmentalrights andinstitutionalconstraints. Foundational prerequisite forselectedPublicInternationalLaw inenvironmentaltrial."
    },
    "GOSLAWJ212": {
      "name": "Introduction to Public International Law",
      "prerequisite": "GOSGATE102",
      "contribution": "Treaties,environmentalprotection,humanrights,compliance andpoliticalcritique withresearchpodcast supportinternationalenvironmentalpolicycommunication. Notfullsciencecommunication orpublicadministration equivalence."
    },
    "GOSPOLI112": {
      "name": "Foundations of Comparative Politics",
      "prerequisite": "NONE",
      "contribution": "Institutions,participation,polarisation,interestgroups andempiricalcomparativepolitics supportpubliccommunication/collectivechange; notalife-sciencelab orcampaigncourse."
    },
    "GOSPOLI311": {
      "name": "European Union Politics",
      "prerequisite": "NONE",
      "contribution": "EUrepresentation,agenda-setting,interests,policyimplementation andempiricalamendmentcoding directlysupportpoliticalpower/communication questions inenvironmentalgovernance."
    },
    "GOSSOCI111": {
      "name": "Introduction to Sociology",
      "prerequisite": "NONE",
      "contribution": "Sociologicaltheory,identity,stratification,inequality andliterature-basedsocialproblemanalysis explainhow publicmessages/socialchange operate within socialstructures. No originalfielddatacollection invented."
    },
    "GOSSOCI212": {
      "name": "Qualitative Research Methodology",
      "prerequisite": "NONE",
      "contribution": "Interviews,focusgroups,ethnography/visualmethods,coding/NVivo andteamqualitativeresearch directly implement interpretivecommunication/health inquiry."
    },
    "GOSSOCI215": {
      "name": "Social Movements & Environmental Justice",
      "prerequisite": "NONE",
      "contribution": "Description-supported socialmovements,EnvironmentalJusticeAtlascases,feminism/anti-colonialism/degrowth andcivicengagement supportenvironmentalpublicparticipation. No unsaidinterview/fieldproject method invented."
    },
    "HCBBIOM111": {
      "name": "Epidemiology & Public Health",
      "prerequisite": "NONE",
      "contribution": "Diseasefrequency,risk,design,bias/confounding/causality,healthneeds/screening andlocalZeelandpopulation/stakeholderproject directly supportevidence-informed publichealth communication."
    },
    "HCBGATE101": {
      "name": "Foundation of Life, Health & Biomedicine",
      "prerequisite": "NONE",
      "contribution": "Cell/molecular/metabolic/genetic foundations andpublishedexperimentanalysis supply actualbiomedicaldomain knowledge forhealthcommunication,not six-domain sciencecommunication orientation."
    },
    "HCBGATE102": {
      "name": "Introduction to Brain & Behavior",
      "prerequisite": "NONE",
      "contribution": "Neural/psychologicalbehaviour,learning,socialinfluence andmentalhealth researchappraisal groundhealthbehaviour/psychology andsatisfydependentformalprerequisites. Not clinicaltraining."
    },
    "HCBLIFE212": {
      "name": "Human Physiology",
      "prerequisite": "HCBGATE101",
      "contribution": "Homeostasis,adultorgans andregulation withliteraturereview/peerrevision providehealth-domain substance for interpretinghealthclaims; notcommunicationintervention design."
    },
    "HCBPSYC111": {
      "name": "Social Psychology",
      "prerequisite": "NONE",
