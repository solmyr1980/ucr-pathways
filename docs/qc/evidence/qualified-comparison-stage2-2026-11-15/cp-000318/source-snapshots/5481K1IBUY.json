roduction to Buddhism"]},{"name":"englishNameLong","type":"STRING","values":["Introduction to Buddhism"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Introduction to Buddhism DLT"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["N"]}],"weighting":0.00},{"assessment":{"category":"E","code":"5481K1IBUT","id":"209670","key":115929,"module":{"code":"5481K1IBUY","id":"209671","names":[{"language":"EN","value":"Introduction to Buddhism"},{"language":"NL","value":"Introduction to Buddhism"}],"uid":"2108ac6c-c608-40f9-a936-36b56462a770"},"names":[{"language":"EN","value":"Introduction to Buddhism (TEN)"},{"language":"NL","value":"Introduction to Buddhism (TEN)"}],"type":"TEN","typeAbbreviation":"TEN","uid":"b43df651-2e8b-4d75-b70b-0090d415b2b2","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Introduction to Buddhism (TEN)"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"opmerkingenToetsvorm","type":"STRING","values":["Mondeling"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5481K1IBUY"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Introduction to Buddhism"]},{"name":"englishNameLong","type":"STRING","values":["Introduction to Buddhism"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Introduction to Buddhism (TEN)"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":80.00},"code":"5481K1IBUY","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"This course provides a general introduction to Buddhism as a religious system; set of philosophies and doctrines; and cultural force. The study of Buddhism also provides an excellent opportunity to approach basic human questions and to reflect on one’s own cultural presuppositions. The course surveys the historical background of Buddhism from its Indian origins through its development and spread through Asia; through lectures; with an emphasis on primary sources (which are to be read here in translation) and secondary studies.\r\rWe will discuss the following topics (but students are encouraged to express their own interests; which will be accomodated):\r\r* General introduction: why is it important to study Buddhism and how should we do this?\r* The life and legacy of the founder; “the Buddha” through narrative; art; poetry\r* The essential teachings of Buddhism and the bewildering variety of interpretations\r* How did Buddhism function in India and its new homes in Asia\r* What is life; death; and rebirth according to Buddhism?\r* Buddhist philosophy: what do Buddhists debate about?\r* Buddhist monasticism: ideals and reality\r* The various forms of the religion: Mahāyāna; Zen; Tantric Buddhism\r* How did Buddhism end in India?","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"* John Strong; Buddhisms: An Introduction (electronically available in the library)\n*  Thich Nhat Hanh: The Heart of Understanding, or: The Other Shore. \n* Online readings, either through library link or on BrightSpace.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"Multiple-choice exams, closed book, with written questions and short-answer identifications of images.\nThe final mark for the course is established by determining the weighted average of the partial grades.\nMid-term is 30%, Final 70%.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"\n\nEnrolment through [MyStudyMap](https://mijn.universiteitleiden.nl/login) is mandatory.\nGeneral information about course and exam enrolment is available on the [website](https://www.student.universiteitleiden.nl/en/administrative-matters/registration--de-registration/course-and-exam-enrolment/course-and-exam-enrolment/humanities/art-history-ba?cf=university&cd=guest#tab-2)\n\n#### Registration *À la carte education*, *Contract teaching* and *Exchange*\n\nInformation for those interested in taking this course in context of [À la carte education ](https://www.universiteitleiden.nl/en/education/other-modes-of-study/contract-and-non-examination-courses/a-la-carte-education) (without taking examinations), eg. about costs, registration and conditions.\n\nInformation for those interested in taking this course in context of [Contract teaching](https://www.universiteitleiden.nl/en/education/other-modes-of-study/contract-and-non-examination-courses/contract-teaching) (with taking examinations), eg. about costs, registration and conditions.\n\nFor the registration of exchange students contact [Humanities International Office](mailto:exchange@hum.leidenuniv.nl).\n","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"Through this course you will gain a familiarity with basic chronological/historical information about Buddhism; Buddhist cosmology; the major movements of ideas and practices in Buddhism over time; the major forces acting on Buddhism over time; the major sources for the study of Buddhism; and think about questions such as the nature of authority; its sources; regionalism and its effects; the place of religion in life; and the tensions brought out by religious thinking. Hopefully you will develop a continued fascination with one of the major cultural forces of Asia (and; increasingly; the Euro-American world). The approach of the course is entirely non-confessional: on the contrary; it emphasises the large variety of perspectives one can take when studying Buddhism.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"None.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"* For substantive questions; contact the lecturer listed in the right information bar.\r* For questions about enrolment; admission; etc; contact the Education Administration Office [Herta Mohr](https://www.organisatiegids.universiteitleiden.nl/en/faculties-and-institutes/humanities/faculty-office/student-affairs/education-administration-offices/herta-mohr-education-administration-office)","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"* Lecture","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through [My Timetable](https://rooster.universiteitleiden.nl/schedule).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"#### Resit\n\nIf the final grade is insufficient (5.49 or lower), a resit may be offered. This resit will cover the entire subject matter and will count for 100% of the final grade.\n\n#### Review and feedback\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results at the latest. If a student requests a review within 30 days after publication of the exam results, an exam review will have to be organized.\n","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"209671","key":103974,"methods":[{"method":{"category":"T","code":"5481K1IBUH","contactHours":26.00,"id":"209668","key":120055,"module":{"code":"5481K1IBUY","id":"209671","names":[{"language":"EN","value":"Introduction to Buddhism"},{"language":"NL","value":"Introduction to Buddhism"}],"uid":"2108ac6c-c608-40f9-a936-36b56462a770"},"names":[{"language":"EN","value":"Introduction to Buddhism"},{"language":"NL","value":"Introduction to Buddhism (LEC)