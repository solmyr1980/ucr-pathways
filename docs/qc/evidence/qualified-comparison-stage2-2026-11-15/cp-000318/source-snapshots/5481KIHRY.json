"STRING","values":["Introduction to Hindu Religions"]},{"name":"englishNameLong","type":"STRING","values":["Introduction to Hindu Religions"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Intr. to Hindu Religion DLT"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["N"]}],"weighting":0.00},{"assessment":{"category":"E","code":"5481KIHRT","id":"236886","key":113071,"module":{"code":"5481KIHRY","id":"236887","names":[{"language":"EN","value":"Introduction to Hindu Religions"},{"language":"NL","value":"Introduction to Hindu Religions"}],"uid":"54b6be68-3555-48da-ab93-95e062ac1236"},"names":[{"language":"EN","value":"Introduction to Hindu Religions"},{"language":"NL","value":"Introduction to Hindu Religions"}],"type":"TEN","typeAbbreviation":"TEN","uid":"67bf32e0-ba2d-4f53-815b-0a34c66d8893","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["false"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Intr. to Hindu Religion TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5481KIHRY"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Introduction to Hindu Religions"]},{"name":"englishNameLong","type":"STRING","values":["Introduction to Hindu Religions"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Intr. to Hindu Religion TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"criteria":"1,0","required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":45.00},"code":"5481KIHRY","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"This course provides a general introduction to the various religious and cultural traditions associated with Hinduism; from a historical as well as a thematic perspective. It traces the origins and evolution of these diverse traditions which converged into a pan-Indian religion under the label Hinduism. The course takes an open and pluralistic approach to the study of Hindu religions; not only by drawing attention to the diversity of traditions; but also aiming to define general features of a unified religion. Students will also be introduced to the modern and contemporary trajectories of Hinduism through the colonial; post-colonial and contemporary periods; both within India and in Hindu communities spread across the world.\r\rTopics addressed in the course will include: identity formation of ‘Hinduism’; ritual and religion of the Vedas; Hindu mythology; theology and philosophy; devotion and pilgrimage; Hinduism and society; Hindu social; intellectual and political movements in the modern period; Hindu nationalism; Media and Hinduism and Hindu diaspora.\rThe course will welcome students to understand Hinduism historically; both as theory and practice; and also; as a social; cultural and political formation.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"The booktitles and / or syllabi  to be used in the course; where it can be purchased and how this literature should be studied beforehand.\r* Readings are provided in the form of secondary literature along with primary sources and are distributed in weekly folders via Brightspace. Students are required to go through the readings before the class in order to actively engage with the course. Students are expected to attend all classes.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"The course has 2 written examinations: one written examination at the end of the first block (counting for 50% of the final mark) and one written examination with essay questions at the end of the second block (counting for 50% of the final mark). The course is an integrated whole. Both examinations must be completed in the same academic year. No partial marks can be carried over into following years","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through [MyStudyMap](https://mijn.universiteitleiden.nl/login) is mandatory.\rGeneral information about course and exam enrolment is available on the [website]( https://www.student.universiteitleiden.nl/en/administrative-matters/registration--de-registration/course-and-exam-enrolment/course-and-exam-enrolment/humanities/art-history-ba?cf=humanities&cd=art-history-ba#tab-2).","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"* Knowledge of key terms; concepts; texts and traditions of Hindu religions;\r* Familiarity with the historical background and development of Hindu religions;\r* Awareness of the diversity of Hindu religious cultures and traditions;\r* Understanding of the cultural and political dimensions of Hinduism in the modern and contemporary world;\r* Critical awareness of the relation between theory and practice in studying Hinduism.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"This course is open to BA1 students as well as exchange and study abroad students. No prior knowledge of Hinduism and India is required to join this course.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"* For substantive questions; contact the lecturer listed in the right information bar.\r* For questions about enrolment; admission; etc; contact the Education Administration Office [Herta Mohr](https://www.organisatiegids.universiteitleiden.nl/en/faculties-and-institutes/humanities/faculty-office/student-affairs/education-administration-offices/herta-mohr-education-administration-office)","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"Lecture","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"#### Resit\n\nIf the final grade is insufficient (5.49 or lower), a resit may be offered. This resit will cover the entire subject matter and will count for 100% of the final grade.\n\n#### Review and feedback\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results at the latest. If a student requests a review within 30 days after publication of the exam results, an exam review will have to be organized.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"236887","key":101229,"methods":[{"method":{"category":"T","code":"5481KIHRH","contactHours":26.00,"id":"236884","key":117588,"module":{"code":"5481KIHRY","id":"236887","names":[{"language":"EN","value":"Introduction to Hindu Religions"},{"language":"NL","value":"Introduction to Hindu Religions"}],"uid":"54b6be68-3555-48da-ab93-95e062ac1236"},"names":[{"language":"EN","value":"Introduction to Hindu Religions"},{"language":"NL","value":"Introduction to Hindu Religions"}],"type":"LEC","typeAbbreviation":"LEC","uid":"de86660a-ebd3-4824-9adb-9a8c3742c19c","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5481KIHRY"]},{"name":"numberOfGroups","values":["1"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["N"]},{"name":"dutchNameLong","type":"STRING","values":["Introduction to Hindu Religions"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Intr. to Hindu Religions LEC"]},{"name":"Werkvorm","type":"STRING","values":["LEC"]},{"name":"englishNameShort","type":"STRING","values":["Intr. to Hindu Religions LEC"]},{"name":"englishNameLong","type":"STRING","values":["Introduction to Hindu Religions"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","