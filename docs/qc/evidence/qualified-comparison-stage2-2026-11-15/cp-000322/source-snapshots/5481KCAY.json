{"code":"5481KCAY","credits":5.00,"data":{"additional":{"values":[{"name":"language","subType":"EDUCATION_LANGUAGE","type":"ELEMENT","values":["ENG"]},{"name":"exchange","type":"BOOLEAN","values":["true"]},{"name":"studyguideLocation","subType":"StudyLocation","type":"REFERENCE","values":["L"]},{"name":"optional","type":"BOOLEAN","values":["true"]},{"name":"alacarte","type":"BOOLEAN","values":["false"]},{"name":"minorvak","type":"BOOLEAN","values":["false"]},{"name":"evening","type":"BOOLEAN","values":["false"]},{"name":"contract","type":"BOOLEAN","values":["false"]},{"name":"inclusion","type":"BOOLEAN","values":["false"]},{"name":"honours","type":"BOOLEAN","values":["false"]},{"name":"level","subType":"DIFFICULTY","type":"ELEMENT","values":["200"]},{"name":"loopbaan","subType":"loopbaanRef","type":"REFERENCE","values":["10"]}]},"assessments":[{"assessment":{"category":"E","code":"5481KCAT","id":"269915","key":130057,"module":{"code":"5481KCAY","id":"269916","names":[{"language":"EN","value":"Classics of Asia"},{"language":"NL","value":"Classics of Asia"}],"uid":"6471e430-98f2-4b02-8a95-c1c3f3c55850"},"names":[{"language":"EN","value":"Classics of Asia TEN"},{"language":"NL","value":"Classics of Asia TEN"}],"type":"TEN","typeAbbreviation":"TEN","uid":"f7a22372-323f-4fff-9e57-b9cbdd721091","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Classics of Asia TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5481KCAY"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Classics of Asia TEN"]},{"name":"englishNameLong","type":"STRING","values":["Classics of Asia TEN"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Classics of Asia TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":50.00},"code":"5481KCAY","credits":{"optimum":5.00},"descriptions":[{"language":"EN","text":"*The Art of War*, *Tao Teh Ching*, *Laws of Manu*, *Kama Sutra*, *Tale of Genji*, *Mahabharata*, *Ramayana* — Asia has produced numerous foundational texts that have profoundly shaped local cultures and extended their influence far beyond their original contexts. These texts have served as sources of ethical and moral reflection, literary inspiration, political thought and statecraft, and religious authority. The classics raise important questions about their creation, the materials used in their composition, their fluidity before and after finalization, their role in shaping elite culture, and their enduring significance from the past to the present day. How important is the tradition of commentary surrounding these texts? Through what media are they transmitted? How are they adopted, adapted, and translated across different cultures? This course offers a comparative introduction to the history, transmission, and afterlives of major Asian classics.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"The course readings consist of selected passages from classical works (in translation), supplemented by secondary literature. All materials will be made available via Brightspace.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"* Homework assignments: 10%\n* Exams: 90%\n    \\- Midterm exam: 20%\n    \\- Final exam: 80%\n     \n    1) A passing grade (5.5 or higher) on the final exam is required to pass the course as a whole.\n    2) Students who obtain a grade below 5.5 on the final exam, or whose combined exam grade is below 5.5, may take the resit exam.\n    3) The resit grade replaces the combined midterm and final exam grade and counts for 100% of the exam component.\n\n\\* Detailed instructions on the *homework assignment* will be outlined in the course syllabus.\n\\* The *Exams (90%)* component is made up of a *midterm exam (20%)* and a *final exam (80%)*.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the [website](https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university)","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"* knowledge of the production, transmission, and reception of foundational Asian texts\n* understanding of how classics have functioned in Asian cultures across time and space\n* critical awareness of the relationship between the classic, canon formation, cultural capital, and elite culture\n* ability to reflect on the long-term cross-cultural connections and global afterlives of Asian classics","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"Not applicable.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions, contact the lecturers (listed in the right information bar).  For questions about enrolment, admission, etc., contact the Education Administration Office: [Herta Mohr](osz-oa-mohr@hum.leidenuniv.nl).","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"Lecture","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"When the exam results are announced, students will also be informed of the time and format of the exam review session. In any case, an exam review session will be organized if a student requests one within 30 days of the announcement of the results.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"269916","key":130055,"methods":[{"method":{"category":"T","code":"5481KCAH","contactHours":26.00,"id":"269914","key":130056,"module":{"code":"5481KCAY","id":"269916","names":[{"language":"EN","value":"Classics of Asia"},{"language":"NL","value":"Classics of Asia"}],"uid":"6471e430-98f2-4b02-8a