{"id":"7c56321e-380f-4967-a19c-7fe223978210","year":"2026-2027","code":"CFBGR05705","facultyCode":"cf","facultyTitle":{"en":"Campus Fryslân","nl":"Campus Fryslân"},"title":{"en":"Data for Future Energy and Climate (200)","nl":""},"fullTitle":{"en":"Data for Future Energy and Climate (200)","nl":""},"goals":{"en":"Upon the successful completion of this course, students will be able to:\r\n\r\n- be able to critically assess data flows from observing and monitoring to modeling to evidence-based policy-making\r\n- Describe the interrelation between climate change and fossil fuels\r\n-Demonstrate how the energy transition to renewables is required for climate change mitigation\r\n- Explain how to deal with the “intermittency” of renewables in the current and future systems \r\n- Select and apply climate and energy data to predict and resolve energy issues\r\n- Differentiate and compare the sources of uncertainty from energy and climate data, and assess the importance of projections\r\n- Make climate, vegetation, and energy predictions based on Earth System Models and integrated assessment Models","nl":""},"description":{"en":"The Energy and Climate Data course aims at using and critically assessing the relationship between climate and energy data. Different sources of data will be analyzed, contextualized, and their uncertainty and validity will be discussed. We will look at past, present, and future datasets from observations, satellites, and climate models. Both climate and emission scenarios will be theoretically compared, and students will make their own projections, plots, and interpretations of the data. \n\nIn particular, the course will address the Sustainable Development Goals 7 and 13.\n\nIn this course, we will build on skills from The Earth Systems, Introduction to Sustainable Energy Transition, and Homes and Cars.\n\nThe course will have three core elements: \n\n1) Students will learn about theoretical concepts and the relationships between climate, (renewable) energy, and their intermittency; \n2) Student-led sessions will deepen and widen their understanding of these concepts; and\n3) Work sessions based on Python will allow students to translate the theoretical concepts into practical applications.","nl":""},"credits":5.00,"hours":4,"levels":["BACHELOR"],"formats":[],"formatsExplanation":{"en":"Lectures\nStudent-led sessions\nWorkshops","nl":""},"assessmentsExplanation":{"en":"","nl":""},"courseTypes":[{"id":"91824ff6-f7bf-4923-b12b-2a21f03c4e43","position":0,"optionList":{"id":"639c4fba-cddd-4593-acb5-5c11b667a363","textEn":"Bachelor","textNl":"Bachelor","position":1,"deletedSince":null,"availableSince":null}}],"prerequisites":{"en":"","nl":""},"draft":false,"otherPeriods":false,"organizationalUnit":"71453b8c-d842-40cc-b6d5-e9b6e31ec5ca","organizationalUnitTitle":{"en":"Org Campus Fryslân ","nl":"Org Campus Fryslân"},"startYear":null,"endYear":null,"legacyAssessments":{"en":"","nl":""},"legacyCourseTypes":{"en":"","nl":""},"legacyFormats":{"en":"","nl":""},"legacyTermExplanationEn":"","legacyTermExplanationNl":"","enlight":"NOT_ENLIGHT","modifiedAt":[2026,7,6,12,9,27,354629000],"courseOfferings":[{"id":"1bd1a79e-c317-4858-8bce-1370b48f489b","offeringCode":"CFBGR05705.2026-2027.1","scheduleLink":"","staff":[{"id":"4cb99c71-4bee-4540-a37d-4d11f4a18bf0","username":"","givenName":"Sarah","familyName":"Feron","titlePrefix":"dr","titleSuffix":"","initials":"S.C.","customText":"","roles":["COORDINATOR","LECTURER"],"mepaId":"s.c.feron","email":"s.c.feron@rug.nl","sortIndex":0}],"books":[],"software":[],"language":["ENGLISH"],"remarksEn":"","remarksNl":"","term":{"id":"3c5ec331-f6dc-44a1-931f-9882fe66dc43","orgUnit":{"id":"0f3ff37e-8d4a-437e-a32a-1bee94492552","code":"rug","titleEn":"University of Groningen","titleNl":"Rijksuniversiteit Groningen","ouClass":"UNIVERSITY","parent":null},"ugTerms":["TERM1B"],"academicYear":"2026-2027","startDate":[2026,11,9],"endDate":[2027,1,31],"nameEn":"Semester 1b","nameNl":"Semester 1b","