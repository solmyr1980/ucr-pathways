dutchNameLong","type":"STRING","values":["Historische Taalkunde"]},{"name":"englishNameLong","type":"STRING","values":["Historical Linguistics"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Historische Taalkunde TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":40.00},"code":"5511VN006Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"NL","text":"Een inleiding in de historische taalkunde, hoofdzakelijk geïllustreerd aan de hand van het Nederlands en het Engels.\n\nWoorden veranderen van vorm en betekenis, talen veranderen van woord- en zinsbouw. Op wat voor manieren gebeurt dat?\n\nDe cursus levert een eerste inleiding in de volgende onderwerpen:\n\\> lexicale verandering\n\\> fonologische verandering\n\\> morfologische verandering\n\\> syntactische verandering\n\\> taalcontact en resultaten daarvan zoals creolisering\\.\n\\> de vergelijkende methode\n\\> uitdagingen voor de vergelijkende methode\\, m\\.n\\. vanuit de dialectologie\n\\> bewuste taalverandering door taalkundige manipulatie\n\nIn de presentaties (5 min.) behandelen de studenten een de geschiedenis en de etymologie van een Nederlands woord dat hun zal worden opgedragen.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"NL","text":"Boek: Robert McColl Millar: *Trask's Historical Linguistics* (NB: zowel de 3e druk uit 2015 als de vierde druk uit 2023 kunnen worden gebruikt). Routledge.\n\nTer voorbereiding voor de presentatie worden studenten verwezen naar de [Portal Academic Skills](https://eur03.safelinks.protection.outlook.com/?url=https%3A%2F%2Frise.articulate.com%2Fshare%2F1at6p8jE716jWa8EVu0FM0BthUhG3h8U&data=05%7C01%7Cstuco-ba-linguistics%40hum.leidenuniv.nl%7C6c9bc6386dcc449d62ff08db4a296f67%7Cca2a7f76dbd74ec091086b3d524fb7c8%7C0%7C0%7C638185314036803749%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C3000%7C%7C%7C&sdata=AThXYWGKs8%2Fp5FW64bnsYu4HIQJHIZ87l3b9wCz5qac%3D&reserved=0) van de BA Taalwetenschap. Bestudeer vooral modules 3.1, 3.2 en 3.3.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"NL","text":"* Mondelinge presentatie (20%)\n* Eindtentamen (80%)\n\nBeide onderdelen moeten met minimaal een 5,5 behaald worden om het vak succesvol af te sluiten.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"NL","text":"Inschrijven via MyStudyMap (knop in rechter bovenhoek) is verplicht. Informatie over het inschrijven voor vakken en tentamens kun je vinden op de website https://www.student.universiteitleiden.nl/je-opleiding/vakken-en-toetsen/inschrijven/universiteit-leiden","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"NL","text":"* Kennis van en inzicht in de methodologie van de historische taalwetenschap.\n* De vaardigheid om dit opgedane inzicht toe te passen op niet behandelde data.\n* Kennis van de terminologie van de historische taalwetenschap.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"NL","text":"Enige basiskennis van de fonologie; fonetiek en het IPA; bijvoorbeeld opgedaan in de cursus Klanken van de wereld. Studenten die niet het college [Taal en cultuur van de Indo-Europeanen](https://studiegids.universiteitleiden.nl/modules/5511VE004Y) gevolgd hebben wordt aangeraden de reader van dat vak aan te schaffen en zelfstandig door te nemen.\n\nGeïnteresseerde keuzevakstudenten dienen eerst contact op te nemen voor zij zich inschrijven (stuco-ba-linguistics@hum.leidenuniv.nl).","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"NL","text":"Voor inhoudelijke vragen, neem contact op met de docent(en) (rechts in de informatiebalk).  Voor informatie over inschrijvingen, toelating, etc., neem contact op met de Onderwijsadministratie: osz-oa-reuvensplaats@hum.leidenuniv.nl","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"NL","text":"Hoorcollege (1 uur per week) en werkcollege (1 uur per week )","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"NL","text":"De roosters zijn beschikbaar via My Timetable (zie de knop rechtsboven in).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"NL","text":"### Herkansing\n\nBeide onderdelen kunnen worden herkanst.\n\n### Inzage en nabespreking\n\nUiterlijk bij het bekendmaken van de uitslag van het tentamen wordt aangegeven op welke wijze en op welk tijdstip de inzage en nabespreking van het tentamen plaatsvindt. Er wordt in ieder geval een nabespreking georganiseerd indien een student hiertoe verzoekt, uiterlijk binnen 30 dagen na bekendmaking van de uitslag en in ieder geval voordat de tweede tentamengelegenheid plaatsvindt.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"249705","key":103662,"methods":[{"method":{"category":"T","code":"5511VN006H","contactHours":13.00,"id":"249701","key":119830,"module":{"code":"5511VN006Y","id":"249705","names":[{"language":"EN","value":"Historical Linguistics"},{"language":"NL","value":"Historische Taalkunde"}],"uid":"273698ba-1be4-430f-937e-666f5524afa8"},"names":[{"language":"EN","value":"Historical Linguistics LEC"},{"language":"NL","value":"Historische Taalkunde LEC"}],"type":"LEC","typeAbbreviation":"LEC","uid":"d61ff7ac-305a-473d-8112-0be6d2a2a8e5","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5511VN006Y"]},{"name":"numberOfGroups","values":["1"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["N"]},{"name":"dutchNameLong","type":"STRING","values":["Historische Taalkunde"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Historische Taalkunde LEC"]},{"name":"Werkvorm","type":"STRING","values":["LEC"]},{"name":"englishNameShort","type":"STRING","values":["Historical Linguistics LEC"]},{"name":"englishNameLong","type":"STRING","values":["Historical Linguistics"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["ZB"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN