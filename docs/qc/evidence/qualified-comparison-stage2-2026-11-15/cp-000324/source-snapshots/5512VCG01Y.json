{"code":"5512VCG01Y","credits":5.00,"data":{"additional":{"values":[{"name":"language","subType":"EDUCATION_LANGUAGE","type":"ELEMENT","values":["ENG"]},{"name":"exchange","type":"BOOLEAN","values":["true"]},{"name":"studyguideLocation","subType":"StudyLocation","type":"REFERENCE","values":["L"]},{"name":"optional","type":"BOOLEAN","values":["true"]},{"name":"alacarte","type":"BOOLEAN","values":["false"]},{"name":"minorvak","type":"BOOLEAN","values":["false"]},{"name":"evening","type":"BOOLEAN","values":["false"]},{"name":"contract","type":"BOOLEAN","values":["false"]},{"name":"inclusion","type":"BOOLEAN","values":["false"]},{"name":"honours","type":"BOOLEAN","values":["false"]},{"name":"level","subType":"DIFFICULTY","type":"ELEMENT","values":["100"]},{"name":"loopbaan","subType":"loopbaanRef","type":"REFERENCE","values":["10"]}]},"assessments":[{"assessment":{"category":"E","code":"5512VCG01T","id":"259301","key":112411,"module":{"code":"5512VCG01Y","id":"259278","names":[{"language":"EN","value":"Language and Logic"},{"language":"NL","value":"Language and Logic"}],"uid":"2fe004eb-b106-4f8a-8f4b-9f1cdd3d3971"},"names":[{"language":"EN","value":"Language and Logic"},{"language":"NL","value":"Language and Logic"}],"type":"TEN","typeAbbreviation":"TEN","uid":"f7d01456-a5b5-4378-9dee-8fbd19de6ea8","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Language and Logic TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5512VCG01Y"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Language and Logic"]},{"name":"englishNameLong","type":"STRING","values":["Language and Logic"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Language and Logic TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":40.00},"code":"5512VCG01Y","credits":{"optimum":5.00},"descriptions":[{"language":"EN","text":"Human language isn’t always logical... or is it? This course provides an introduction to logic and its relation to language. You will gain an understanding of the historic and contemporary relations between formal language and natural language, you will learn to read and write logical formulae and compose basic proofs (propositional logic, predicate logic), and you will become acquainted with recent research on logic and language in fields such as semantics/pragmatics, language acquisition, psycholinguistics, and computational linguistics.\n\nWe will study several chapters with exercises from the classic introductory book Logic, Language and Meaning (Volume 1) by Gamut, as well as exemplary articles from the primary research literature. While this course is a part of the BA Linguistics, we welcome students from other fields, for whom both the logical skills and the insights into language can be equally valuable!","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"* L.T.F. Gamut. Logic, Language, and Meaning, Volume 1: Introduction to Logic (first, and only, edition, 1990)\n* Module 2.3 from the Portal Academic Skills on [Argumentation](https://rise.articulate.com/share/1at6p8jE716jWa8EVu0FM0BthUhG3h8U#/lessons/ceeS2_IQ5xIdYku9UDQulVqF66VvOmGr).\n\nAdditional materials and research papers will be provided during the course.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"### Assessment\n\nThere will be one, final written exam with a mix of closed questions, short open questions and essay questions.\n\n### Weighing\n\nThe written exam comprises 100% of the grade.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the website ","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"* You will be able to explain correspondences and differences between formal language and natural language, both from a historical and contemporary perspective.\n* You will be able to read and write logical formulae, and to understand and compose simple logical proofs, in propositional logic and predicate logic.\n* You will be able to read and comprehend formally precise academic writing, which is interspersed with mathematical notation, definitions and proofs.\n* You will be able to summarize, at a conceptual level and basic formal level, several research papers from the primary literature on the intersection of logic and language, and to conceive of meaningful research questions in this field.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"No entry requirements. The relations between language and logic can be highly relevant also for students outside the Linguistics BA, who are welcome to join!\n\nIf MyStudymap indicates the course is full, please contact the education coordinator (stuco-ba-linguistics@hum.leidenuniv.nl). If a larger room cannot be found, priority will be given to students from the BA Linguistics.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions, contact the lecturer(s) (listed in the right information bar).  For questions about enrolment, admission, etc., contact the Education Administration Office:  [Reuvensplaats](osz-oa-reuvensplaats@hum.leidenuniv.nl)","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"Lecture","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit\n\nA resit will be offered for the written exam, replacing the original grade entirely.\n\n### Review and feedback\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results at the latest. If a student requests a review within 30 days after publication of the exam results, an exam review will have to be organized.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"259278","key":102580,"methods":[{"method":{"category":"T","code":"5512VCG01W","contactHours":26.00,"id":"259279","key":118960,"module":{"code":"5512VCG01Y","id":"259278","names":[{"language":"EN","value":"Language and Logic"},{"language":"NL","value":"Language and Logic"}],"uid":"2fe004eb-b106-4f8a-8f4b-9f1cdd3d3971"},"names":[{"language":"EN","value":"Language and Logic"},{"language":"NL","value":"Language and Logic"}],"type":"WGR","typeAbbreviation":"WGR","uid":"631b5626-de50-4a0b-bec7-f63664e4905e","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5512VCG01Y"]},{"name":"numberOfGroups","values":["1"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"dutchNameLong","type":"STRING","values":["Language and Logic"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Language and Logic WGR"]},{"name":"Werkvorm","type":"STRING","values":["WGR"]},{"name":"englishNameShort","type":"STRING","values":["Language and Logic WGR"]},{"name":"englishNameLong","type":"STRING","values":["Language and Logic"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["ZB"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false}],"names":[{"language":"EN","value":"Language and Logic"},{"language":"NL","