{"code":"5512VEBE9Y","credits":5.00,"data":{"additional":{"values":[{"name":"language","subType":"EDUCATION_LANGUAGE","type":"ELEMENT","values":["ENG"]},{"name":"exchange","type":"BOOLEAN","values":["true"]},{"name":"studyguideLocation","subType":"StudyLocation","type":"REFERENCE","values":["L"]},{"name":"optional","type":"BOOLEAN","values":["true"]},{"name":"alacarte","type":"BOOLEAN","values":["false"]},{"name":"minorvak","type":"BOOLEAN","values":["false"]},{"name":"evening","type":"BOOLEAN","values":["false"]},{"name":"contract","type":"BOOLEAN","values":["false"]},{"name":"inclusion","type":"BOOLEAN","values":["false"]},{"name":"honours","type":"BOOLEAN","values":["false"]},{"name":"level","subType":"DIFFICULTY","type":"ELEMENT","values":["300"]},{"name":"loopbaan","subType":"loopbaanRef","type":"REFERENCE","values":["10"]}]},"assessments":[{"assessment":{"category":"E","code":"5512VEBE9T","id":"269286","key":130702,"module":{"code":"5512VEBE9Y","id":"269287","names":[{"language":"EN","value":"Language and Prehistory"},{"language":"NL","value":"Language and Prehistory"}],"uid":"760ba402-4831-4586-959c-a0166660179e"},"names":[{"language":"EN","value":"Language and Prehistory TEN"},{"language":"NL","value":"Language and Prehistory TEN"}],"type":"TEN","typeAbbreviation":"TEN","uid":"0689291c-c6db-4af8-88fd-3489d806577b","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Language and Prehistory TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5512VEBE9Y"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Language and Prehistory TEN"]},{"name":"englishNameLong","type":"STRING","values":["Language and Prehistory TEN"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Language and Prehistory TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":50.00},"code":"5512VEBE9Y","credits":{"optimum":5.00},"descriptions":[{"language":"EN","text":"This course studies how linguistics can be used in order to reconstruct prehistory and history, and how, on the other hand, history changes language. \nSubjects that will be treated include: how to classify languages historically; how did lost languages leave their traces in modern languages or in toponyms; theories of language contact; pidgins and creoles; triangulation of linguistic analyses with insights from archaeology and genetics.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"Readings will be announced during class.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"### Assessment and weighing\n\nThe course is assessed by means of:\n(a) a presentation on one of the articles (30%);\n(b) moderating discussions for two other articles (5% each);\n(c) a paper in which the student writes a “peer review” about one of the papers that have been studied in class. This may be the one that the student gave her/his presentation about, but this is not necessary (60%). In order to make sure that no LLM is used in the production of this paper, it will be written during a formal in-class exam.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the website https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"* Knowledge of the main methods and theories concerning the subject of the course.\n* Critical insight into the problems, challenges and possibilities of these methods and theories.\n* Academic skills: critical reflection on scholarly literature; oral presentation; paper.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"No specific requirements. Students need to have a basis in the methods of historical linguistics, e.g. through the BA1 course Historical Linguistics and a basic idea of linguistic terminology.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions, contact the lecturer(s) (listed in the right information bar).  For questions about enrolment, admission, etc., contact the Education Administration Office: osz-oa-reuvensplaats@hum.leidenuniv.nl","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"One hour lecture and one hour seminar. Presence at the seminar is compulsory and regular absence may have to be compensated by an extra assignment or even lead to exclusion from the exam.\n\nDuring the seminar, students present a scholarly paper about the subject of the course chosen from a restricted list. After this, a classroom discussion of the paper takes place, moderated by two other students.","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit\n\nThere are possibilities for a resit.\n\n### Review and feedback\n\n Students will receive feedback on their work through Brightspace. If a student requests a review within 30 days after publication of the exam results, an exam review will be organized.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"269287","key":130698,"methods":[{"method":{"category":"T","code":"5512VEBE9H","contactHours":13.00,"id":"269284","key":130700,"module":{"code":"5512VEBE9Y","id":"269287","names":[{"language":"EN","value":"Language and Prehistory"},{"language":"NL","value":"Language and Prehistory