 the World DLT"]},{"name":"englishNameLong","type":"STRING","values":["Languages of the World DLT"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Languages of the World DLT"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["N"]}],"weighting":0.00},{"assessment":{"category":"E","code":"5511VE001T","id":"236279","key":111565,"module":{"code":"5511VE001Y","id":"236275","names":[{"language":"EN","value":"Languages of the World"},{"language":"NL","value":"Languages of the World"}],"uid":"ad0499e2-ec09-4a4c-accb-9b239401fd2a"},"names":[{"language":"EN","value":"Languages of the World TEN"},{"language":"NL","value":"Languages of the World TEN"}],"type":"TEN","typeAbbreviation":"TEN","uid":"980abffd-d873-4fc9-8ead-5b33e6fa935b","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Languages of the World TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5511VE001Y"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Languages of the World"]},{"name":"englishNameLong","type":"STRING","values":["Languages of the World"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Languages of the World TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":45.00},"code":"5511VE001Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"Which languages are spoken where? And which linguistic features do they show? These questions are at the basis of the course Languages of the World. In this course, you learn about linguistics and language diversity by make a linguistic tour around the world. On the one hand, you will gain insight into the distribution and diversity of the languages of the world and be introduced to salient features of particular languages and language families or areas, including the classification of languages based on genealogical and/or typological features, socio-historical information, as well as their endangerment or vitality status On the other hand, you will familiarise yourself with basic concepts in linguistics, which make it possible to speak about common phenomena in language. This is done on the basis of prominent linguistic phenomena in a number of (primarily non-European) languages, such as transitivity, ergativity and morphological complexity. All along the tour you are challenged to solve linguistic puzzles and discover generalisations.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"* Pereltsvaig, Asya (2024). *Languages of the World: An Introduction*, **fourth edition**. Cambridge: Cambridge University Press.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"### Assessment method\n\nThe assessment consist of a midterm exam and a final written exam.\n\n### Weighing\n\n* Midterm exam (25%)\n* Final exam (75%)\n\nThe final mark for the course is established by determining the weighted average. To pass the course, the weighted average of the partial grades must be 5.5 or higher.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the website https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"By the end of this course students will be able to:\n\n* apply the basic concepts used in linguistics to a range of language structures;\n* provide a basic description of the world’s language diversity, including the genealogical and typological classifications;\n* find reliable information about different languages in the world (e.g. their classification, their vitality, their linguistic features, socio-historical information, bibliography);\n* recognise and describe a number of specific features of languages of the regions covered.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"There are no specific admission requirements.\n\nStudents from outside the BA Linguistics are welcome to join too. If MyStudymap indicates the course is full, please contact the education coordinator ([stuco-ba-linguistics@hum.leidenuniv.nl](mailto:stuco-ba-linguistics@hum.leidenuniv.nl \"mailto:stuco-ba-linguistics@hum.leidenuniv.nl\")) for admission possibilities. If a larger room cannot be found, priority will be given to students from the BA Linguistics.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions, contact the lecturer(s) (listed in the right information bar).  For questions about enrolment, admission, etc., contact the Education Administration Office: osz-oa-reuvensplaats@hum.leidenuniv.nl","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"There is a one hour lecture and a one hour tutorial per week.","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit\n\nIn case of an insufficient final grade, students can take a resit of the final exam.\n\n### Exam review\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results at the latest. If a student requests a review within 30 days after publication of the exam results, an exam review will have to be organized.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"236275","key":105295,"methods":[{"method":{"category":"T","code":"5511VE001W","contactHours":13.00,"id":"236277","key":121144,"module":{"code":"5511VE001Y","id":"236275","names":[{"language":"EN","value":"Languages of the World"},{"language":"NL","value":"Languages of the World"}],"uid":"ad0499e2-ec09-4a4c-accb-9b239401fd2a"},"names":[{"language":"EN","value":"Languages of the World WGR"},{"language":"NL","value":"Languages of the World WGR"}],"type":"WGR","typeAbbreviation":"WGR","uid":"ace507c2-35de-4a3f-be8f-6186eb3157e8","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5511VE001Y"]},{"name":"numberOfGroups","values":["2"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["N"]},{"name":"dutchNameLong","type":"STRING","values":["Languages of the World"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Languages of the World WGR"]},{"name":"Werkvorm","type":"STRING","values":["WGR"]},{"name":"englishNameShort","type":"STRING","values":["Languages of the World WGR"]},{"name":"englishNameLong","type":"STRING","values":["Languages of the World"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["ZB"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false},{"method":{"category":"T","code":"5511VE001H","contactHours":13.00,"id":"236278","key":12114