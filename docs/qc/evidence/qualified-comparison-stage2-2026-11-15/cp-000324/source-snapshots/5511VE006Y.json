:"dutchNameLong","type":"STRING","values":["Historical Linguistics"]},{"name":"englishNameLong","type":"STRING","values":["Historical Linguistics"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Historical Linguistics TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":40.00},"code":"5511VE006Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"The pronunciation, structure and meaning of words and sentences change over time. How does language change? \nThis course provides answers to these questions with the help of examples from various languages, often, but not exclusively, English and closely related languages such as Dutch. \nThe course provides a first introduction to the following topics:\n\\> lexical change\n\\> phonological change\n\\> morphological change\n\\> syntactic change\n\\> language contact and outcomes such as creolization\n\\> the comparative method\n\\> challenges to the comparative method\\, esp\\. from dialectology\n\\> conscious change through language manipulation\n\nStudent presentations (5 min.) are about the history and etymology of an English word that will be assigned to them.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"Book: Robert McColl Millar: *Trask's Historical Linguistics* (NB: either 3rd ed., from 2015 or the fourth ed. from 2023). Routledge.\n\nIn preparation of the presentation, students can make use of the [Portal Academic Skills](https://eur03.safelinks.protection.outlook.com/?url=https%3A%2F%2Frise.articulate.com%2Fshare%2F1at6p8jE716jWa8EVu0FM0BthUhG3h8U&data=05%7C01%7Cstuco-ba-linguistics%40hum.leidenuniv.nl%7C6c9bc6386dcc449d62ff08db4a296f67%7Cca2a7f76dbd74ec091086b3d524fb7c8%7C0%7C0%7C638185314036803749%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C3000%7C%7C%7C&sdata=AThXYWGKs8%2Fp5FW64bnsYu4HIQJHIZ87l3b9wCz5qac%3D&reserved=0) of the BA Linguistics. In particular, take a look at modules 3.1, 3.2 and 3.3.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"### Assessment and weighing\n\nOral presentation (20%)\nFinal written presentation (80%)\n\nBoth parts need to be completed with a minimum of 5.5 in order to successfully pass the course.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the website https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"* Knowledge of and insight in the methodology of historical linguistics.\n* The skills to apply these insights to new data.\n* Knowledge of the terminology of historical linguistics.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"Basic knowledge of phonology; phonetics and IPA. Students who have not followed the course [Language and Culture of the Indo-Europeans](https://studiegids.universiteitleiden.nl/courses/134720/language-and-culture-of-the-indo-europeans) are advised to purchase and study the reader of that course.\n\nStudents who are not enrolled in the BA Linguistics should first contact the coordinator of studies","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions, contact the lecturer(s) (listed in the right information bar).  For questions about enrolment, admission, etc., contact the Education Administration Office: osz-oa-reuvensplaats@hum.leidenuniv.nl ","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"Lectures (1 hour weekly) and seminars (1 hour weekly).","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit\n\nA resit is possible for both components.\n\n### Review and feedback\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results at the latest. If a student requests a review within 30 days after publication of the exam results and before the second exam moment takes place an exam review will have to be organized.","type":{"code":"RRD","id":"RRD","names":[{"lang