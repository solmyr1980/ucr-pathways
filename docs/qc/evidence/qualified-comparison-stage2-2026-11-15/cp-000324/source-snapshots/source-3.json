es":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Description of a Non-western Language II: Berber"]},{"name":"englishNameLong","type":"STRING","values":["Description of a Non-western Language II: Berber"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Descr. Non-west. Lang II TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":45.00},"code":"5512VEBE2Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"Important note: this course only takes place once every two years. Students for whom this is a compulsory part of their studies program should make sure that they follow this course in the year that it is offered.\n\nBerber (Tamazight) is spoken by about one third of the population in Morocco and a quarter of the population of Algeria.\nIn this course, the grammatical structure of one specific Berber language will be studied, Tarifiyt (Riffian Berber) as spoken in the city of Nador in Morocco. Tarifiyt is the heritage language of most people with a Moroccan migration background in the Netherlands.\nIn the course, the main grammatical structures of the language will be studied. It will involve reading (transcripts of a spoken) texts. This is not a language acquisition course and neither speaking nor listening will be practised.\nIn addition to the linguistic structures of the language there will be due attention to its cultural context: sociolinguistics of Northern Africa, language and identity; literature, writing traditions etc.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"A syllabus will be provided during the course.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"Written examination with short open questions and involving translation of a fully glossed tekst (100%)","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the website https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"Knowledge and insight about Tarifiyt Berber and about its linguistic and cultural context. \nInsight in the linguistic structure and gaining deeper insight into linguistic structures in general on the basis of one specific language. Critical insight into matters of language and identity.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"Basic knowledge of linguistics is required.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","t