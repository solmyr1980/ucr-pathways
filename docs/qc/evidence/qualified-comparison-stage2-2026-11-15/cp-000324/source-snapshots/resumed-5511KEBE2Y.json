ype":"STRING","values":["Word and Meaning TEN"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["ZB"]},{"name":"dutchNameShort","type":"STRING","values":["Word and Meaning TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["N"]}],"weighting":0.00},{"assessment":{"category":"E","code":"5511KEBE2R","id":"236489","key":109641,"module":{"code":"5511KEBE2Y","id":"236484","names":[{"language":"EN","value":"Word and Meaning"},{"language":"NL","value":"Word and Meaning"}],"uid":"2fed900e-e434-452e-9db5-96cfa7c7cae3"},"names":[{"language":"EN","value":"Word and Meaning SCH"},{"language":"NL","value":"Word and Meaning SCH"}],"type":"SCH","typeAbbreviation":"SCH","uid":"efe6121e-4f46-4583-8178-1aaf7c5d3790","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI0"]},{"name":"englishNameShort","type":"STRING","values":["Word and Meaning SCH"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5511KEBE2Y"]},{"name":"Toetsvorm","type":"STRING","values":["SCH"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Word and Meaning"]},{"name":"englishNameLong","type":"STRING","values":["Word and Meaning"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Word and Meaning SCH"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":60.00},"code":"5511KEBE2Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"To understand the nature of language and culture we must understand words. What is in a word? A word is a unit that carries meaning in a language. In this course we focus on the forms and meanings of words in the languages of the world. We explore the question of how we can describe the meanings of words and document the knowledge they embody in the world’s languages. We investigate the relations that words of a language have with each other (lexical relations). Some words in a language have the same form: they are pronounced in the same way or they are written in the same way. Compare for example, the Dutch forms *bloem* ‘flour’ and *bloem* ‘flower’: they are pronounced and written in the same way (note also that the English equivalents for them are written differently, but pronounced in the same way). Are the meanings of *bloem* related, or not? Where the meanings are related we will explore the mechanisms by which the meanings of words are extended to other related meanings, for instance through metaphor or metonymy.\n\nWords are not only an important mirror of the mind (Leibniz), they also provide a guide to the social reality of the users of languages. Connotations and other associated meanings of words form an important window through which we can discover the patterns. In this regard, we will examine the diversity of connotations across languages.\nDictionaries are the storehouse of the words of languages. We will discuss the principles for making *explanatory* *dictionaries* that capture the entire worlds of words – from their pronunciations to translation equivalents, definitions, and cultural and historical information.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"The readings for the course will be given in class.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"### Assessment\n\nThere will be four assignments spread throughout the semester and they will count for 30% of the final grade.\nThere will be a final group assignment, this counts for 70% of the final grade.\n\n### Weighing\n\nAssignments 30%\nFinal assignment 70%","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the website ( https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university/guest?cd=guest&cd=gast&cf=university).","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"* Students will gain knowledge and insight in different aspects of words in a language, the types of information they carry and convey in interaction and the relations in which they participate.\n* Students will gain knowledge and insight in the documentation of lexical knowledge in languages\n* Students will be introduced to current linguistic approaches to the study of word meanings (semantics): lexical fields, semantic frames, meaning-text theory and the Natural Semantic Metalanguage approach.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"None.\n\nStudents from outside the BA Linguistics are welcome to join too. If MyStudymap indicates the course is full, please contact the education coordinator ([stuco-ba-linguistics@hum.leidenuniv.nl](mailto:stuco-ba-linguistics@hum.leidenuniv.nl \"mailto:stuco-ba-linguistics@hum.leidenuniv.nl\")). If a larger room cannot be found, priority will be given to students from the BA Linguistics.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions, contact the lecturer(s) (listed in the right information bar).  For questions about enrolment, admission, etc., contact the Education Administration Office:  osz-oa-reuvensplaats@hum.leidenuniv.nl","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"* Lecture\n* Tutorial","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit\n\nStudents can resit the final exam.\n\n### Review and feedback\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"236484","key":103660,"methods":[{"method":{"category":"T","code":"5511KEBE2H","contactHours":13.00,"id":"236487","key":119827,"module":{"code":"5511KEBE2Y","id":"236484","names":[{"language":"EN","value":"Word and Meaning"},{"language":"NL","value":"Word and Meaning"}],"uid":"2fed900e-e434-452e-9db5-96cfa7c7cae3"},"names":[{"language":"EN","value":"Word and Meaning LEC"},{"language":"NL","value":"Word and Meaning LEC"}],"type":"LEC","typeAbbreviation":"LEC","uid":"19ce290a-1d1d-4478-9ca9-d9219f84eecb","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5511KEBE2Y"]},{"name":"numberOfGroups","values":["1"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["N"]},{"name":"dutchNameLong","type":"STRING","values":["Word and Meaning LEC"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Word and Meaning LEC"]},{"name":"Werkvorm","type":"STRING","values":["LEC"]},{"name":"englishNameShort","type":"STRING","values":["Word and Meaning LEC"]},{"name":"englishNameLong","type":"STRING","values":["Word and Meaning LEC"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["ZB"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false},{"method":{"category":"T","code":"5511KEBE2W","contactHours":