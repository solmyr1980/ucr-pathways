","values":["Vedic Sanskrit"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Vedic Sanskrit DLT"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["N"]}],"weighting":0.00},{"assessment":{"category":"E","code":"5512VEV10T","id":"265546","key":116585,"module":{"code":"5512VEV10Y","id":"265167","names":[{"language":"EN","value":"Vedic Sanskrit"},{"language":"NL","value":"Vedic Sanskrit"}],"uid":"c99dda6c-d815-4c4e-b743-b7c2c263aec9"},"names":[{"language":"EN","value":"Vedic Sanskrit"},{"language":"NL","value":"Vedic Sanskrit"}],"type":"TEN","typeAbbreviation":"TEN","uid":"dd7877f0-317b-4540-9eb6-de8b75dcfbd1","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Vedic Sanskrit TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5512VEV10Y"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Vedic Sanskrit"]},{"name":"englishNameLong","type":"STRING","values":["Vedic Sanskrit"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Vedic Sanskrit TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":24.00},"code":"5512VEV10Y","credits":{"optimum":10.00},"descriptions":[{"language":"EN","text":"This course provides an introduction to Vedic Sanskrit, the language of the Vedas, especially that of the Rigveda. In the first half, we will focus on synchronic phonology and morphology. In class, we will combine lecture-style introductions to the phonology and morphology of Vedic Sanskrit with interactive discussions of weekly assignments where students will apply their acquired knowledge to analyse Sanskrit words and sentences. In the second half, we will focus on the major facets of Sanskrit historical grammar in the fields of phonology and morphology. We will discuss the way Sanskrit developed out of the Proto-Indo-European ancestor language, how Sanskrit relates to other Indo-European languages, and in what way Sanskrit can be used for reconstructing Proto-Indo-European.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"Macdonell, Arthur A. 1916. A Vedic grammar for students (reprinted many times; any edition may be used)\n\nAdditional readings will be announced in the course. Moreover, syllabi and other course materials will be provided during the course and uploaded to Brightspace.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"### Assessment\n\nTwo written exams with short open questions.\n\n### Weighing\n\nThe two written exams each count for 50% of the final grade.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the website https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"At the end of the course, students are expected to:\n\n* have insight into the cultural significance of Vedic Sanskrit literature and the prehistory of Indo-Iranian languages and peoples;\n* memorize the most important nominal, pronominal and verbal paradigms of Vedic Sanskrit;\n* be able to use linguistic terminology to analyse Vedic phonology as well as nominal and verbal morphology;\n* be able to use standard dictionaries and grammars to analyse Sanskrit words and forms;\n* have knowledge of the historical grammar of Sanskrit phonology and morphology;\n* be able to predict the Sanskrit outcome of Proto-Indo-European reconstructions;\n* be able to reconstruct the Proto-Indo-European ancestor of Sanskrit words.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"Basic knowledge of linguistics and Indo-European reconstruction.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions, contact the lecturer(s) (listed in the right information bar).  For questions about enrolment, admission, etc., contact the Education Administration Office: osz-oa-reuvensplaats@hum.leidenuniv.nl","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"Interested students are welcome. If you are in doubt about the admission requirements, please contact the teacher.","type":{"code":"RM","id":"RM","names":[{"language":"EN","value":"Remarks"},{"language":"NL","value":"Opmerkingen"}],"uid":"c22c1513-23c4-41d5-aaf6-8ca4854ef2ea"}},{"language":"EN","text":"Seminar, 4 hours per week","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit\n\nStudents who fail one or both of the written examinations are allowed to a resit.\n\n### Review and feedback\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results at the latest. If a student requests a review within 30 days after publication of the exam results, an exam review will have to be organized.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"265167","key":108342,"methods":[{"method":{"category":"T","code":"5512VEV10W","contactHours":52.00,"id":"265168","key":125880,"module":{"code"