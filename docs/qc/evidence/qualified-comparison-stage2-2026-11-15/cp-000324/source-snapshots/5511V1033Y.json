":["Morphology"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Morfologie DLT"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["N"]}],"weighting":0.00},{"assessment":{"category":"E","code":"5511V1033T","id":"203565","key":109794,"module":{"code":"5511V1033Y","id":"203549","names":[{"language":"EN","value":"Morphology"},{"language":"NL","value":"Morfologie"}],"uid":"898aa35a-1caf-40d1-8bd0-f810b1beb624"},"names":[{"language":"EN","value":"Morphology TEN"},{"language":"NL","value":"Morfologie TEN"}],"type":"TEN","typeAbbreviation":"TEN","uid":"f32eca32-4916-468b-b5e4-e0b996df5f5c","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Morphology TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5511V1033Y"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Morfologie"]},{"name":"englishNameLong","type":"STRING","values":["Morphology"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Morfologie TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":45.00},"code":"5511V1033Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"NL","text":"Morfologie is de studie van woordstructuur, waarbij twee aspecten centraal staan: woordvorming en flexie. Iedere taal heeft middelen om de woordenschat uit te breiden door middel van woordvormingsprocessen zoals het maken van samenstellingen. Daarnaast hebben woorden vaak meer dan één vorm (flexie), waarbij de keuze van een specifieke woordvorm afhankelijk kan zijn van de syntactische omgeving, zoals, bijvoorbeeld, in talen met naamvallen. Morfologie kijkt dus niet alleen naar de structuur van woorden op zich maar ook naar de interactie met de syntaxis. De morfologische vorm van een woord kan effect hebben op de uitspraak ervan (interactie met de fonologie) en bepaalt deels de betekenis ervan (interactie met semantiek). Morfologie kan dus omschreven worden als ‘grammatica op woordniveau’, en is van groot belang voor taalbeschrijving, historische taalkunde, taaltypologie, lexicografie en psycholinguïstiek.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"NL","text":"Lieber, Rochelle (2016). *Introducing Morphology* (second or third edition). Cambridge: Cambridge University Press.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"NL","text":"### Toetsing \n\nToetsing vindt plaats door middel van een schriftelijk tussen- en eindtentamen met korte open vragen.\n\n### Weging\n\n* Tussententamen (30%)\n* Eindtentamen (70%)\n\nHet eindcijfer voor de cursus wordt bepaald door het gewogen gemiddelde van de resultaten van de tentamens.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"NL","text":"Inschrijven via MyStudyMap (knop in rechter bovenhoek) is verplicht. Informatie over het inschrijven voor vakken en tentamens kun je vinden op de website (https://www.student.universiteitleiden.nl/en/administrative-matters/registration--de-registration/course-and-exam-enrolment/course-and-exam-enrolment/).","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"NL","text":"Aan het eind van deze cursus beschikken de studenten over:\n\n* kennis van en inzicht in morfologische verschijnselen;\n* kennis van morfologische verschillen tussen talen;\n* inzicht in de structuur van het lexicon en de rol van woordstructuur bij taalproductie en -perceptie;\n* vaardigheid in het inzichtelijk glossen van morfologische structuren;\n* kennis van de belangrijkste taaltheoretische inzichten over woordstructuur.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"NL","text":"Geen.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"NL","text":"Voor inhoudelijke vragen, neem contact op met de docent(en) (rechts in de informatiebalk).  Voor informatie over inschrijvingen, toelating, etc., neem contact op met de Onderwijsadministratie: osz-oa-reuvensplaats@hum.leidenuniv.nl","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"NL","text":"Hoorcollege (1 uur) en daarnaast werkcollege (1 uur), in meerdere groepen, met bespreking van huiswerkopdrachten en interactie tussen docent en deelnemers, die ook beurten krijgen.","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"NL","text":"De roosters zijn beschikbaar via My Timetable (zie de knop rechtsboven in).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"NL","text":"### Herkansing\n\nBij een onvoldoende eindcijfer, kan het eindtentamen herkanst worden.\n\n### Inzage en nabespreking\n\nUiterlijk bij het bekendmaken van de uitslag van het tentamen wordt aangegeven op welke wijze en op welk tijdstip de nabespreking van het tentamen plaatsvindt. Er wordt in ieder geval een nabespreking georganiseerd indien een student hiertoe verzoekt binnen 30 dagen na bekendmaking van de uitslag.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"203549","key":103641,"methods":[{"method":{"category":"T","code":"5511V1033H","contactHours":0.00,"id":"203563","key":119813,"module":{"code":"5511V1033Y","id":"203549","names":[{"language":"EN","value":"Morphology"},{"language":"NL","value":"Morfologie"}],"uid":"898aa35a-1caf-40d1-8bd0-f810b1beb624"},"names":[{"language":"EN","value":"Morphology LEC"},{"language":"NL","value":"Morfologie LEC"}],"type":"LEC","typeAbbreviation":"LEC","uid":"d50a0bc2-58a9-43c0-9bb8-64374955ecc8","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5511V1033Y"]},{"name":"numberOfGroups","values":["1"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["N"]},{"name":"dutchNameLong","type":"STRING","values":["Morfologie"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Morfologie LEC"]},{"name":"Werkvorm","type":"STRING","values":["LEC"]},{"name":"englishNameShort","type":"STRING","values":["Morphology LEC"]},{"name":"englishNameLong","type":"STRING","values":["Morphology"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["ZB"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false},{"method":{"category":"T","code":"5511V1033W","contactHours":13.00,"id":"203564","key":119814,"module":{"code":"5511V1033Y","id":"203549","names":[{"language":"EN","value":"Morphology"},{"language":"NL","value":"Morfologie"}],"uid":"898aa35a-1caf-40d1-8bd0-f810b1beb624"},"names":[{"language":"EN","value":"Morphology WGR"},{"language":"NL","value":"Morfologie WGR"}],"type":"WGR","typeAbbreviation":"WGR","uid":"f0425cc3-ea9f-4f78-a0f2-c04224ce9ed5","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5511V1033Y"]},{"name":"numberOfGroups","values":["2"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["N"]},{"name":"dutchNameLong","type":"STRING","values":["Morfologie"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Morfologie WGR"]},{"name":"Werkvorm","type":"STRING","values":[