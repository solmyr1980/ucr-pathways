{"code":"5511VE002Y","credits":5.00,"data":{"additional":{"values":[{"name":"language","subType":"EDUCATION_LANGUAGE","type":"ELEMENT","values":["ENG"]},{"name":"exchange","type":"BOOLEAN","values":["true"]},{"name":"studyguideLocation","subType":"StudyLocation","type":"REFERENCE","values":["L"]},{"name":"optional","type":"BOOLEAN","values":["true"]},{"name":"alacarte","type":"BOOLEAN","values":["true"]},{"name":"minorvak","type":"BOOLEAN","values":["true"]},{"name":"evening","type":"BOOLEAN","values":["false"]},{"name":"contract","type":"BOOLEAN","values":["true"]},{"name":"inclusion","type":"BOOLEAN","values":["false"]},{"name":"honours","type":"BOOLEAN","values":["false"]},{"name":"level","subType":"DIFFICULTY","type":"ELEMENT","values":["100"]},{"name":"loopbaan","subType":"loopbaanRef","type":"REFERENCE","values":["10"]}]},"assessments":[{"assessment":{"category":"E","code":"5511VE002T","id":"236285","key":109693,"module":{"code":"5511VE002Y","id":"236281","names":[{"language":"EN","value":"Sociolinguistics"},{"language":"NL","value":"Sociolinguistics"}],"uid":"7b210d39-27f9-4a37-ad52-f92860a35378"},"names":[{"language":"EN","value":"Sociolinguistics TEN"},{"language":"NL","value":"Sociolinguistics TEN"}],"type":"TEN","typeAbbreviation":"TEN","uid":"6a829503-c948-45eb-9ea0-c96733b0dba0","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Sociolinguistics TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5511VE002Y"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Sociolinguistics"]},{"name":"englishNameLong","type":"STRING","values":["Sociolinguistics"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Sociolinguistics TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":100.00},"code":"5511VE002Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"In the lectures, we will look at the ways in which language is used as a means to define and maintain social cohesion and experience and manage diversity – by individuals, groups, and authorities alike. The main focus is the individual and their use of language as a means to structure their life. We will also learn how groups of people can be recognised linguistically through identities and orientations of all kinds as well as culture and shared interests. In addition, we will study micro- and macro-variation, diglossia, and register variation. We will study topics like multilingualism, education, folk linguistics, language perception and evaluation. Another topic is how authorities – both official and unofficial – use language as a means towards organising and structuring societies, including the public space. A wide range of language varieties will be dealt with, to demonstrate how some sociolinguistic mechanisms seem to be shared by many cultures while others are highly local.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"Smakman, Dick (2018). *Discovering Sociolinguistics*. From Theory to Practice. London: MacMillan","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"* Mid-term Multiple-choice Exam (50%)\n* Final Multiple-choice Exam (50%)\n\nThe final mark for the course is the weighted average of the partial grades. To pass the course; this weighted average must be 5.5 or higher. One of the partial grades may be lower than 5.5.","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through [My Studymap](https://mijn.universiteitleiden.nl/login) is mandatory.","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"This course introduces students to both classic and contemporary sociolinguistic theories and research. The lectures explore these studies in depth, providing students with a solid understanding of key concepts and analytical approaches in the field. Together with the coursebook chapters, they encourage students to think critically about the ways in which language reflects social, situational, and cultural contexts. Students learn to interpret patterns of language variation and develop a critical perspective on popular and often oversimplified beliefs about language, languages, and language use. More broadly, the course fosters critical reflection on the relationship between language, society, and human behaviour.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"None.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions; contact the lecturer listed in the right information bar\r\rFor questions related to the content of the course; please contact the lecturer; you can find their contact information by clicking on their name in the sidebar.\r\rFor questions regarding enrollment please contact the [Education Administration Office Reuvensplaats](https://www.organisatiegids.universiteitleiden.nl/faculteiten-en-instituten/geesteswetenschappen/faculteitsbureau/onderwijs--en-studentzaken/onderwijsondersteuning/onderwijsadministratie-reuvensplaats)\rSend an E-mail: osz-oa-reuvensplaats@hum.leidenuniv.nl\r\rFor questions regarding your studyprogress contact the [Coordinator of Studies](mailto:stuco-ba-linguistics@hum.leidenuniv.nl)","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"Weekly 90-minute seminar (‘hoorcollege’)","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit\n\nYou can resit course components if your course grade is below 5.5. You can only resit components whose grade is below 5.5. You can take the resit Multiple-choice Exam during the resit period. This will be a new exam with different questions.\n\n### Review and feedback\n\nThose who wish to review the Multiple-choice Exam may contact the teacher, who will then organise a group video chat or actual meeting.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"236281","key":103635,"methods":[{"method":{"category":"T","code":"5511VE002H","contactHours":26.00,"id":"236284","key":119806,"module":{"code":"5511VE002Y","id":"236281","names":[{"language":"EN","value":"Sociolinguistics"},{"language":"NL","value":"Sociolinguistics"}],"uid":"7b210d39-27f9-4a37-ad52-f92860a35378"},"names":[{"language":"EN","value":"Sociolinguistics LEC"},{"language":"NL","value":"Sociolinguistics LEC"}],"type":"LEC","typeAbbreviation":"LEC","uid":"926b5b74-03b4-4a06-b199-e4f366bd7ea8","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5511VE002Y"]},{"name":"numberOfGroups","values":["1"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["N"]},{"name":"dutchNameLong","type":"STRING","values":["Sociolinguistics"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Sociolinguistics LEC"]},{"name":"Werkvorm","type":"STRING","values":["LEC"]},{"name":"englishNameShort","type":"STRING","values":["Sociolinguistics LEC"]},{"name":"englishNameLong","type":"STRING","values":["Sociolinguistics"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["ZB"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false}],"names":[{"language":"EN","value":"Sociol