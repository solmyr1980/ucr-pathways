,"values":["Language and Communication"]},{"name":"englishNameLong","type":"STRING","values":["Language and Communication"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["ZB"]},{"name":"dutchNameShort","type":"STRING","values":["Language and Communication DLT"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":false,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["N"]}],"weighting":0.00},{"assessment":{"category":"E","code":"5511VE010T","id":"238129","key":111017,"module":{"code":"5511VE010Y","id":"238125","names":[{"language":"EN","value":"Language and Communication"},{"language":"NL","value":"Language and Communication"}],"uid":"edd0d078-ae41-4df3-80ee-ef55ea4d54ee"},"names":[{"language":"EN","value":"Language and Communication TEN"},{"language":"NL","value":"Language and Communication TEN"}],"type":"TEN","typeAbbreviation":"TEN","uid":"0cbb6a48-05d5-4be1-8232-af3f94296542","values":[{"name":"examDateFlag","type":"BOOLEAN","values":["true"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEITEN10"]},{"name":"englishNameShort","type":"STRING","values":["Language and Communication TEN"]},{"name":"PACC","type":"BOOLEAN","values":["true"]},{"name":"resit","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"studiegidsnummerY","type":"STRING","values":["5511VE010Y"]},{"name":"Toetsvorm","type":"STRING","values":["TEN"]},{"name":"infCredits","type":"STRING","values":["5"]},{"name":"exam","subType":"StudieactAanmaken","type":"REFERENCE","values":["ScheduleY"]},{"name":"dutchNameLong","type":"STRING","values":["Language and Communication"]},{"name":"englishNameLong","type":"STRING","values":["Language and Communication"]},{"name":"schedulePrint","subType":"yesNoReference","type":"REFERENCE","values":["Y"]},{"name":"gradingScale","subType":"gradingScaleRef","type":"REFERENCE","values":["GRD"]},{"name":"dutchNameShort","type":"STRING","values":["Language and Communication TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":50.00},"code":"5511VE010Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"This course offers a general introduction to the study of language in use, studying language from a communicative perspective: how does linguistic communication work?\n\nPeople use language to communicate but this is not simply a matter of encoding and decoding meaning. What speakers intend to communicate is often more than what they literally say, or it may even be something different (as in the case of irony). A big chunk of language in use is indirect, for instance out of politeness considerations. Researchers of language use try to determine how hearers can work out the meaning intended on the basis of linguistic and non-linguistic information. Among the first to answer this question systematically, were philosophers like Searle (speech act theory) and Grice, who introduced ‘the cooperative principle’. These theories we take as starting point for the course, also studying later developments like neo-Gricean pragmatics and Relevance Theory.\n\nWhereas the study of language as a system is often restricted to the level of the word and the clause, the study of language and communication also takes into account the level of discourse, ranging from principles of turn-taking in spontaneous conversations to coherence relations in written texts. Just like language users apply the rules of grammar, they also behave according to specific norms when, for instance, switching the topic in a WhatsApp conversation or when deciding which degree of politeness is required in a specific genre or medium of communication. Researchers of language and communication try to make explicit the principles underlying such choices, that will of course be highly context-dependent and culture-specific.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"Please purchase before the beginning of the course: Billy Clark, *Pragmatics, the basics.* Routledge, 2022.\n\nBesides, a reader will be provided.","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"### Assessment method and weighing\n\n* Written examination with closed and short open questions after part 1 (40%)\n* Written examination with closed and short open questions after part 2; covering the entire course (60%)\n\nThe final mark for the course is established by determination of the weighted average (40/60).","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the [website](https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university)","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"At the end of this course you will be able to\n\n* provide an overview of the main research topics and approaches in the domain of language and communication ;\n* explain and illustrate in what respects the various approaches differ;\n* analyse concrete instances of language use from different media in terms of the theories discussed;\n* explain how the norms for language use studied are systematically related to genre; medium and culture.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"Student in bachelor or premaster Linguistics.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions; contact the lecturer listed in the right information bar\n\nFor questions related to the content of the course; please contact the lecturer; you can find their contact information by clicking on their name in the sidebar.\n\nFor questions regarding enrollment please contact the [Education Administration Office Reuvensplaats](https://www.organisatiegids.universiteitleiden.nl/faculteiten-en-instituten/geesteswetenschappen/faculteitsbureau/onderwijs--en-studentzaken/onderwijsadministraties/onderwijsadministratie-reuvensplaats)\nE-mail address Education Administration Office Reuvensplaats: osz-oa-reuvensplaats@hum.leidenuniv.nl\n\nFor questions regarding your study progress contact the study adviser: stuco-ba-linguistics@hum.leidenuniv.nl","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"Please note that seminar attendance is mandatory. Students may miss up to two seminars, provided they have a valid reason and notify the lecturer prior to the session to be missed.","type":{"code":"RM","id":"RM","names":[{"language":"EN","value":"Remarks"},{"language":"NL","value":"Opmerkingen"}],"uid":"c22c1513-23c4-41d5-aaf6-8ca4854ef2ea"}},{"language":"EN","text":"Lecture (1 hour per week) and seminar (1 hour per week)","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit, review & feedback\n\nThere is no separate resit for the first examination. The resit covers the entire material of the course.\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results at the latest.","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"238125","key":102191,"methods":[{"method":{"category":"T","code":"5511VE010H","contactHours":14.00,"id":"238127","key":118615,"module":{"code":"5511VE010Y","id":"238125","names":[{"language":"EN","value":"Language and Communication"},{"language":"NL","value":"Language and Communication"}],"uid":"edd0d078-ae41-4df3-80ee-ef55ea4d54ee"},"names":[{"language":"EN","value":"Language and Communication LEC"},{"language":"NL","value":"Language and Communication LEC"}],"type":"LEC","typeAbbreviation":"LEC","uid":"3697ec77-a76b-404a-bd42-83d1cb0b6687","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5511VE010Y"]},{"name":"numbe