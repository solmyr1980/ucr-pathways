,"values":["Phonology I TEN"]}],"year":{"code":"2026-2027","id":"2261","names":[{"language":"EN","value":"2026-2027"},{"language":"NL","value":"2026-2027"}],"uid":"07254806-916f-4cca-82a0-2e69a4a95e9f"}},"required":true,"values":[{"name":"evaluate","subType":"yesNoReference","type":"REFERENCE","values":["Y"]}],"weighting":1.00}],"capacity":{"optimum":100.00},"code":"5511VE003Y","credits":{"maximum":5.00,"minimum":5.00,"optimum":5.00},"descriptions":[{"language":"EN","text":"This course introduces the linguistic subfield of Phonology. Phonology deals with the knowledge and representations of the sound structure of language. The sound structure involves phonemes, features, syllables, stress, and tone. These basic concepts will be introduced and the techniques of a phonological analysis will be explained and practised in small workgroups.","type":{"code":"CO","id":"CO","names":[{"language":"EN","value":"Description"},{"language":"NL","value":"Beschrijving"}],"uid":"9b0c3e97-ad09-42d7-a5bb-afdaf6f1877f"}},{"language":"EN","text":"Zsiga, E. (2024). The Sounds of Language: An Introduction to Phonetics and Phonology. Malden, MA, and Oxford: Wiley-Blackwell","type":{"code":"LI","id":"LI","names":[{"language":"EN","value":"Reading list"},{"language":"NL","value":"Literatuurlijst"}],"uid":"fbd93a9e-ca99-4bcc-807f-39235bb6000b"}},{"language":"EN","text":"### Assessment method\n\n### Assessment\n\n* Weekly homework assignments, these must be handed in weekly to make the grade of the midterm exam count towards the final grade\n* Midterm exam\n* Final exam containing short open questions and essay questions\n\n### Weighing\n\nMidterm: 30% (only when all homework assignments are turned in)\nFinal Exam: 70%. The grade for the Final Exam must be 5.5 or higher to pass the course","type":{"code":"TP","id":"TP","names":[{"language":"EN","value":"Assessment method"},{"language":"NL","value":"Toetsing en weging"}],"uid":"687f9ba4-4330-4ab9-8536-be9ebd2c58c5"}},{"language":"EN","text":"Enrolment through MyStudyMap (button in upper right corner) is mandatory. General information about course and exam enrolment is available on the website https://www.student.universiteitleiden.nl/en/your-study-programme/courses-and-exams/enrolment/leiden-university","type":{"code":"ENR","id":"ENR","names":[{"language":"EN","value":"Registration"},{"language":"NL","value":"Inschrijven"}],"uid":"a77a2043-b0a9-450d-b780-1e90a4d3290c"}},{"language":"EN","text":"Upon successful completion of the course, students demonstrate elementary knowledge of:\n\n* features and their role in phonological processes and sound inventories;\n* syllable structure;\n* stress systems.\n\nThey are also able to, at an elementary level: \n\n* analyze phonological alternations;\n* describe phonological alternations in terms of rules;\n* syllabify sound sequences;\n* analyze stress systems.","type":{"code":"LO","id":"LO","names":[{"language":"EN","value":"Course objectives"},{"language":"NL","value":"Leerdoelen"}],"uid":"b54eb210-96e8-490d-aadb-a70571a665d9"}},{"language":"EN","text":"Not applicable.","type":{"code":"AR","id":"AR","names":[{"language":"EN","value":"Admission requirements"},{"language":"NL","value":"Toegangseisen"}],"uid":"2c481598-5834-4422-a338-1eb346d6f52c"}},{"language":"EN","text":"For substantive questions, contact the lecturer(s) (listed in the right information bar).  For questions about enrolment, admission, etc., contact the Education Administration Office: osz-oa-reuvensplaats@hum.leidenuniv.nl","type":{"code":"CG","id":"CG","names":[{"language":"EN","value":"Contact"},{"language":"NL","value":"Contact"}],"uid":"35f7e88a-830a-4877-b467-86a700954d19"}},{"language":"EN","text":"* Lecture\r* Workgroup","type":{"code":"WV","id":"WV","names":[{"language":"EN","value":"Teaching method"},{"language":"NL","value":"Onderwijsvorm"}],"uid":"26f0e596-e48d-46ff-8c8b-9b9688699943"}},{"language":"EN","text":"The timetables are available through My Timetable (see the button in the upper right corner).","type":{"code":"SC","id":"SC","names":[{"language":"EN","value":"Schedule"},{"language":"NL","value":"Rooster"}],"uid":"939373d2-217d-4dde-9c37-6f6101f1ab75"}},{"language":"EN","text":"### Resit\n\nA resit for the final exam (only) will be organized.\n\n### Review and feedback\n\nHow and when an exam review will take place will be disclosed together with the publication of the exam results at the latest. If a student requests a review within 30 days after publication of the exam results, an exam review will have to be organized","type":{"code":"RRD","id":"RRD","names":[{"language":"EN","value":"Resit, review & feedback"},{"language":"NL","value":"Herkansing, inzage & nabespreking"}],"uid":"ef7be178-91d7-4f56-a40b-891976f3af1c"}}],"faculty":{"code":"FGW","id":"FGW","names":[{"language":"EN","value":"Humanities"},{"language":"NL","value":"Geesteswetenschappen"}],"uid":"28c8aabb-f896-444f-895c-63ef88ba9307"},"id":"236287","key":103689,"methods":[{"method":{"category":"T","code":"5511VE003W","contactHours":13.00,"id":"236289","key":119847,"module":{"code":"5511VE003Y","id":"236287","names":[{"language":"EN","value":"Phonology I"},{"language":"NL","value":"Phonology I"}],"uid":"430fa849-ac91-4761-8ea9-2f98e6bdace8"},"names":[{"language":"EN","value":"Phonology I WGR"},{"language":"NL","value":"Phonology I WGR"}],"type":"WGR","typeAbbreviation":"WGR","uid":"0f81c5ed-18b5-4d94-b4a0-72bcc4fd1281","values":[{"name":"studiegidsnummerY","type":"STRING","values":["5511VE003Y"]},{"name":"numberOfGroups","values":["5"]},{"name":"examDateFlag","subType":"yesNoReference","type":"REFERENCE","values":["N"]},{"name":"dutchNameLong","type":"STRING","values":["Phonology I"]},{"name":"dynClassData","subType":"dynamicClassDataRef","type":"REFERENCE","values":["LEI5"]},{"name":"dutchNameshort","type":"STRING","values":["Phonology I WGR"]},{"name":"Werkvorm","type":"STRING","values":["WGR"]},{"name":"englishNameShort","type":"STRING","values":["Phonology I WGR"]},{"name":"