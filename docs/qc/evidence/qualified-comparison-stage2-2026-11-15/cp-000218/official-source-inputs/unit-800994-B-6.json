{"items":[{"rubriek":"rubriek-links","velden":[{"veld":"item-links","waarde":[{"velden":[{"titel":"Schedule","url":"https://cloud.timeedit.net/nl_tiu/web/public/s.html?sid=3&object=course_800994-B-6-2026-BLOK%201&type=course&object=course_800994-B-6-2026-BLOK%202&type=course&object=course_800994-B-6-2026-BLOK%203&type=course&object=course_800994-B-6-2026-BLOK%204&type=course&object=course_800994-B-6-2026-SM%201&type=course&object=course_800994-B-6-2026-SM%202&type=course&object=course_800994-B-6-2026-JAAR&type=course&object=course_800994-B-6-2026-X&type=course&object=course_800994-B-6-2026-SUMMER&type=course&object=course_800994-B-6-2026-TR%201&type=course&object=course_800994-B-6-2026-TR%202&type=course&object=course_800994-B-6-2026-TR%203&type=course&p=0.m,6.n&h=t"}]}]}]},{"rubriek":"rubriek-zoek","titel":"","weergave":"UIT","velden":[{"veld":"item-faculteit-zoek","titel":"School","waarde":"Tilburg School of Humanities and Digital Sciences"},{"veld":"item-punten-zoek","titel":"Study points","waarde":"6 EC"},{"veld":"item-categorie-zoek","titel":"Category","waarde":"Freshman course Bachelor"},{"veld":"item-voertaal-zoek","titel":"Instruction language","waarde":"English"}]},{"rubriek":"rubriek-kop","titel":"","weergave":"UIT","velden":[{"veld":"cursus","waarde":"800994-B-6"},{"veld":"collegejaar","waarde":2026},{"veld":"cursus_korte_naam","waarde":"Exploring Digital Cultures"},{"veld":"cursus_lange_naam","waarde":"Exploring Digital Cultures"},{"veld":"id_cursus_cursusins","waarde":null},{"veld":"id_cursus_blok_cursusins","waarde":null},{"veld":"id_cursus_toetsins","waarde":null},{"veld":"zowel_cursus_als_toetsins","waarde":"N"},{"veld":"deeplink_detailscherm_extern","waarde":"https://uvt.osiris-student.nl/onderwijscatalogus/extern/cursus?cursuscode=800994-B-6&collegejaar=2026"},{"veld":"item-url-plaatje","titel":"","gegevenstype":"","waarde":""}]},{"rubriek":"rubriek-praktische-info","titel":"Practical information","weergave":"UIT","velden":[{"veld":"regio-links","titel":"","waarde":{"velden":[{"veld":"item-categorie","titel":"Category","waarde":"Freshman course Bachelor"},{"veld":"item-voertaal","titel":"Instruction language","waarde":"English"}]}},{"veld":"regio-rechts","titel":"","waarde":{"velden":[{"veld":"item-opmerking","titel":"Remark","waarde":"Caution: this information is subject to change"}]}}]},{"rubriek":"rubriek-inhoud","titel":"Aims and content","weergave":"UIT","velden":[{"veld":"item-inhoud-1","titel":"Aims","waarde":"<html>\n<head>\n\t<title></title>\n\t<style type=\"text/css\">body { font-size: 9pt; font-family: Arial } table { font-size: 9pt; font-family: Arial }\n\t</style>\n</head>\n<body>\n<p><span style=\"color:#000000\"><u>Knowledge:</u> on successful completion of the course, you will be able to&nbsp;</span></p>\n\n<ul>\n\t<li style=\"list-style-type:disc\"><span style=\"color:#000000\">analyze&nbsp;</span>how digital platforms and media shape visual cultures, styles, and modes of self-presentation.</li>\n\t<li style=\"list-style-type:disc\">explain how social relationships, communities, and identities are constructed and negotiated in online environments</li>\n\t<li style=\"list-style-type:disc\">describe how digital technologies enable and constrain participation, governance, and power relations</li>\n</ul>\n\n<p style=\"text-align:justify\"><span style=\"color:#000000\"><u>Skills</u></span><span style=\"color:#000000\">: after following this course you will be able to:</span></p>\n\n<ul>\n\t<li style=\"list-style-type:disc\">identify, apply, and evaluate relevant academic concepts in the analysis of everyday digital culture</li>\n\t<li style=\"list-style-type:disc\">communicate insights effectively to varied audiences</li>\n\t<li style=\"list-style-type:disc\">and work collaboratively to investigate and present findings.</li>\n</ul>\n\n<p style=\"text-align:justify\"><br />\n<span style=\"color:#000000\"><u>Character building</u>: r</span>eflect on topical societal debates concerning data cultures, algorithmic agency, and platform politics, cultivating critical thinking and responsible digital citizenship.</p>\n</body>\n</html>\n"},{"veld":"item-inhoud-2","titel":"Content","waarde":"<html>\n<head>\n\t<title></title>\n\t<style type=\"text/css\">body { font-size: 9pt; font-family: Arial } table { font-size: 9pt; font-family: Arial }\n\t</style>\n</head>\n<body>\n<p>This course introduces students to the aesthetic, social, and political dimensions of life online. Through critical readings, case studies, and creative exercises, students will explore how digital technologies shape identity, communication, cultural production, and power.</p>\n</body>\n</html>\n"}]},{"rubriek":"rubriek-vrije-velden","titel":"Additional information","weergave":"UIT","velden":[{"veld":"item-vrij-veld-23","titel":"Contact person","gegevenstype":"TEKST","waarde":"<a href=\"https://www.tilburguniversity.edu/nl/medewerkers/tom-vanhout\" target=\"_blank\">Dr T. Van Hout</a>"}]},{"rubriek":"rubriek-toetsen","titel":"Tests","weergave":"IN","velden":[{"veld":"tabel-toetsen","titel":"Tests","waarde":[{"omschrijving":"Group Assignment (40%)","samengestelde-toets":"","is_onderliggend_toets":"N","is_bovenliggende_toets":"N","velden":[{"veld":"item-toets-weging","titel":"Test weight","waarde":"40"},{"veld":"item-toets-resultaatschaal","titel":"Grading scale","waarde":"ten points, two decimal places"}]},{"omschrijving":"Individual Assignment (60%)","samengestelde-toets":"","is_onderliggend_toets":"N","is_bovenliggende_toets":"N","velden":[{"veld":"item-toets-weging","titel":"Test weight","waarde":"60"},{"veld":"item-toets-resultaatschaal","titel":"Grading scale","waarde":"ten points, two decimal places"}]}]}]},{"rubriek":"rubriek-inschrijven","titel":"Course enrolment","weergave":"IN","velden":[{"veld":"tabel-inschrijfperiodes","titel":"Enrolment periods","waarde":[{"omschrijving":"Semester 1","id_cursus_inschrijving":1143879,"velden":[]}]}]},{"rubriek":"rubriek-docenten","titel":"Lecturers","weerg