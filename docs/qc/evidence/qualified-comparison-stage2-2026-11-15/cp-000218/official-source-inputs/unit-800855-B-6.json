":[{"veld":"regio-links","titel":"","waarde":{"velden":[{"veld":"item-categorie","titel":"Category","waarde":"Upper-level course Bachelor"},{"veld":"item-voertaal","titel":"Instruction language","waarde":"English"},{"veld":"item-vrij-veld-5","titel":"Exchange","gegevenstype":"TEKST","waarde":"Available for all levels"}]}},{"veld":"regio-rechts","titel":"","waarde":{"velden":[{"veld":"item-opmerking","titel":"Remark","waarde":"Caution: this information is subject to change"}]}}]},{"rubriek":"rubriek-inhoud","titel":"Aims and content","weergave":"UIT","velden":[{"veld":"item-inhoud-1","titel":"Aims","waarde":"<html>\n<head>\n\t<title></title>\n\t<style type=\"text/css\">body { font-size: 9pt; font-family: Arial } table { font-size: 9pt; font-family: Arial }\n\t</style>\n</head>\n<body><strong><u><span style=\"color:black\">Knowledge</span></u></strong><br />\n<span style=\"color:black\">After completing this course, students will be able to:</span>\n<ol>\n\t<li><span style=\"color:black\"><strong>Explain</strong>&nbsp;and <strong>apply</strong>&nbsp;key concepts and theoretical perspectives relevant to contemporary educational debates.</span></li>\n\t<li><span style=\"color:black\"><strong>Compare</strong>&nbsp;and <strong>evaluate</strong>&nbsp;academic texts and frameworks related to educational theory and policy.</span></li>\n\t<li><span style=\"color:black\"><strong>Interpret</strong>&nbsp;complex academic arguments and <strong>summarize</strong>&nbsp;their key ideas in a coherent and concise manner.</span></li>\n</ol>\n<br />\n<strong><u><span style=\"color:black\">Skills</span></u></strong><br />\n<span style=\"color:black\">After completing this course, students will be able to:</span>\n\n<ol start=\"4\">\n\t<li><span style=\"color:black\"><strong>Formulate</strong>&nbsp;well-reasoned and substantiated analyses of educational issues using academic sources.</span></li>\n\t<li><span style=\"color:black\"><strong>Communicate</strong>&nbsp;their&nbsp;perspectives clearly through written and oral academic discourse.</span></li>\n\t<li><span style=\"color:black\"><strong>Collaborate</strong>&nbsp;effectively in team settings, demonstrating planning, organization, and social communication skills.</span></li>\n</ol>\n<strong><u><span style=\"color:black\">Character</span></u></strong><br />\n<span style=\"color:black\">After completing this course, students will be able to:</span>\n\n<ol start=\"7\">\n\t<li><span style=\"color:black\"><strong>Demonstrate</strong>&nbsp;openness to diverse viewpoints in educational discourse and reflect on their positionality.</span></li>\n\t<li><span style=\"color:black\"><strong>Engage</strong>&nbsp;creatively and responsibly with digital tools in education.</span></li>\n\t<li><span style=\"color:black\"><strong>Take initiative</strong>&nbsp;in developing their academic and professional identity.</span></li>\n</ol>\n</body>\n</html>\n"},{"veld":"item-inhoud-2","titel":"Content","waarde":"<html>\n<head>\n\t<title></title>\n\t<style type=\"text/css\">body { font-size: 9pt; font-family: Arial } table { font-size: 9pt; font-family: Arial }\n\t</style>\n</head>\n<body><strong>Content</strong><br />\nWhat is happening in the land of education at this very moment? What are the current objectives of primary, secondary and higher education? What does education look like in a digital age? What should be and what should not be part of primary and secondary education? What does recent research in education tell us about the educational status quo and what are the perspectives, objectives, ambitions in the light of our current views and values.<br />\n<br />\nThis BA course will look into a few crucial topics in current discussion on education, like digitalization, digital tools, digital literacy, civic education, diversity, research skills, formative assessment, educational myths and educating democracy.&nbsp;In this course, we will introduce you to the learning sciences by focusing on three perspectives on 21<sup>st</sup>&nbsp;century education: the&nbsp;<em>cultural</em>, the&nbsp;<em>cognitive</em>&nbsp;and the&nbsp;<em>digital&nbsp;</em>perspective.</body>\n</html>\n"},{"veld":"item-vrij-veld-1","titel":"Exchange","gegevenstype":"TEKST","waarde":"Available for all levels"}]},{"rubriek":"rubriek-vrije-velden","titel":"Additional information","weergave":"UIT","velden":[{"veld":"item-vrij-veld-23","titel":"Contact person","gegevenstype":"TEKST","waarde":"<a href=\"https://www.tilburguniversity.edu/nl/medewerkers/m-h-m-gijsen\" target=\"_blank\">M.H.M. Gijsen</a>"}]},{"rubriek":"rubriek-toetsen","titel":"Tests","weergave":"IN","velden":[{"veld":"tabel-toetsen","titel":"Tests","waarde":[{"omschrijving":"Writing Assignment 1 (30%)","samengestelde-toets":"","is_onderliggend_toets":"N","is_bovenliggende_toets":"N","velden":[{"veld":"item-toets-weging","titel":"Test weight","waarde":"30"},{"veld":"item-toets-resultaatschaal","titel":"Grading scale","waarde":"ten points, two decimal places"}]},{"omschrijving":"Writing Assignment 2 (40%)","samengestelde-toets":"","is_onderliggend_toets":"N","is_bovenliggende_toets":"N","velden":[{"veld":"item-toets-weging","titel":"Test weight","waarde":"40"},{"veld":"item-toets-resultaatschaal","titel":"Grading scale","waarde":"ten points, two decimal places"}]},{"omschrijving":"Writing Assignment 3 (30%)","samengestelde-toets":"","is_onderliggend_toets":"N","is_bovenliggende_toets":"N","velden":[{"veld":"item-toets-weging","titel":"Test weight","waarde":"30"},{"veld":"item-toets-resultaatschaal","titel":"Grading scale","waarde":"ten points, two decimal places"}]}]}]},{"rubriek":"rubriek-inschrijven","titel":"Course enrolment","weergave":"IN","velden":[{"veld":"tabel-inschrijfperiodes","titel":"Enrolment periods","waarde":[{"omschrijving":"Semester 1","id_cursus_inschrijving":1143823,"velden":[]}]}]},{"rubriek":"rubriek-docenten","titel":"Lecturers","weergave":"IN","velden":[{"veld":"tabel-docenten","titel":"Lecturers","waarde":[{"omschrijvi