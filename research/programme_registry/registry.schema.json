{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solmyr1980.github.io/ucr-pathways/research/programme_registry/registry.schema.json",
  "title": "UCR Pathways Programme Registry Row",
  "description": "Logical schema for one row of the private normalized programme registry. CSV is the current storage format.",
  "type": "object",
  "required": [
    "programme_key",
    "registry_schema_version",
    "institution_id",
    "institution_name",
    "recognised_programme_code",
    "programme_name",
    "level",
    "degree",
    "source_dataset",
    "source_dataset_url",
    "source_license",
    "source_acquired_date",
    "pathways_interest_source",
    "pathways_comparator_candidate",
    "pathways_review_status"
  ],
  "properties": {
    "programme_key": {"type": "string", "minLength": 1, "description": "Stable Pathways join key for programme × provider."},
    "registry_schema_version": {"const": "1.0"},
    "institution_id": {"type": "string"},
    "institution_name": {"type": "string"},
    "recognised_programme_code": {"type": "string"},
    "programme_unit_codes": {"type": "string"},
    "programme_name": {"type": "string"},
    "international_name": {"type": "string"},
    "level": {"type": "string"},
    "degree": {"type": "string"},
    "study_load_ec": {"type": "string"},
    "modes": {"type": "string"},
    "languages": {"type": "string"},
    "locations": {"type": "string"},
    "websites": {"type": "string"},
    "source_types": {"type": "string"},
    "variant_names": {"type": "string"},
    "offering_codes": {"type": "string"},
    "offering_start_date": {"type": "string"},
    "offering_end_date": {"type": "string"},
    "is_bachelor": {"enum": ["TRUE", "FALSE"]},
    "is_wo": {"enum": ["TRUE", "FALSE"]},
    "is_hbo": {"enum": ["TRUE", "FALSE"]},
    "has_full_time": {"enum": ["TRUE", "FALSE"]},
    "has_part_time": {"enum": ["TRUE", "FALSE"]},
    "has_dual": {"enum": ["TRUE", "FALSE"]},
    "source_row_count": {"type": "string", "pattern": "^[0-9]+$"},
    "source_dataset": {"type": "string"},
    "source_dataset_url": {"type": "string", "format": "uri"},
    "source_license": {"type": "string"},
    "source_acquired_date": {"type": "string", "format": "date"},
    "pathways_interest_source": {"enum": ["TRUE", "FALSE"]},
    "pathways_comparator_candidate": {"enum": ["TRUE", "FALSE"]},
    "pathways_comparator_eligible": {"enum": ["", "TRUE", "FALSE"]},
    "pathways_disciplinary_class": {"type": "string"},
    "pathways_review_status": {"type": "string"},
    "pathways_interest_tags": {"type": "string"},
    "pathways_interest_notes": {"type": "string"},
    "pathways_interest_source_urls": {"type": "string"},
    "pathways_verified_comparator_record_id": {"type": "string"},
    "pathways_notes": {"type": "string"}
  },
  "additionalProperties": true
}
